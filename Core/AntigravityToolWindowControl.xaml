<UserControl x:Class="Antigravity_CLI_GUI.AntigravityToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Antigravity_CLI_GUI.Core"
             xmlns:utils="clr-namespace:Antigravity_CLI_GUI.Utilities"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <utils:InverseBooleanConverter x:Key="InverseBoolConverter" />

        <!-- User Message Template: Blue right-aligned bubble -->
        <DataTemplate x:Key="UserTemplate">
            <DockPanel LastChildFill="False" Margin="0,5,0,5">
                <Border Background="#1F69FF"
                        CornerRadius="12,12,0,12"
                        Padding="10,8"
                        Margin="60,0,8,0"
                        HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Text}"
                               Foreground="White"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               MaxWidth="420"/>
                </Border>
            </DockPanel>
        </DataTemplate>

        <!-- Assistant Message Template: Themed left-aligned bubble with Markdown -->
        <DataTemplate x:Key="AssistantTemplate">
            <DockPanel LastChildFill="False" Margin="0,5,0,5">
                <Border Background="#1E1E1E"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        CornerRadius="12,12,12,0"
                        Padding="10,8"
                        Margin="8,0,60,0"
                        HorizontalAlignment="Left">
                    <local:MarkdownViewer DataContext="{Binding}" MaxWidth="420"/>
                </Border>
            </DockPanel>
        </DataTemplate>

        <!-- System / Tool Card Template -->
        <DataTemplate x:Key="SystemTemplate">
            <Border Background="#252526"
                    BorderBrush="#3F3F46"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    Margin="12,5,12,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙ " FontWeight="Bold" Foreground="#9CDCFE"/>
                        <TextBlock Text="{Binding Text}"
                                   Foreground="#CCCCCC"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   MaxWidth="450"/>
                    </StackPanel>

                    <!-- Approve / Deny for permission requests -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,6,0,0"
                                Visibility="{Binding IsPermissionRequest, Converter={StaticResource BoolToVisConverter}}">
                        <Button Content="✔ Approve"
                                Width="90" Height="24"
                                Margin="0,0,6,0"
                                Background="#28A745" Foreground="White"
                                BorderThickness="0"
                                Click="OnApproveClicked"
                                IsEnabled="{Binding IsActionable}"/>
                        <Button Content="✖ Deny"
                                Width="90" Height="24"
                                Background="#C0392B" Foreground="White"
                                BorderThickness="0"
                                Click="OnDenyClicked"
                                IsEnabled="{Binding IsActionable}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <utils:ChatTemplateSelector x:Key="ChatTemplateSelector"
                                    UserTemplate="{StaticResource UserTemplate}"
                                    AssistantTemplate="{StaticResource AssistantTemplate}"
                                    SystemTemplate="{StaticResource SystemTemplate}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Top Header ── -->
        <Border Grid.Row="0"
                Background="#1E1E1E"
                BorderBrush="#3F3F46"
                BorderThickness="0,0,0,1"
                Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="✦ Antigravity"
                           FontWeight="Bold"
                           FontSize="13"
                           Foreground="#1F69FF"
                           VerticalAlignment="Center"/>

                <ComboBox Grid.Column="2"
                          x:Name="ModelSelector"
                          Width="165"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding Models}"
                          SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                          ToolTip="Select the AI model"/>

                <Button Grid.Column="4"
                        x:Name="NewChatButton"
                        Content="New Chat"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        ToolTip="Start a fresh conversation"/>

                <Button Grid.Column="6"
                        x:Name="OpenTerminalButton"
                        Content="Logs"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        ToolTip="Toggle raw terminal output"/>
            </Grid>
        </Border>

        <!-- ── Main Content ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition x:Name="SplitterCol" Width="Auto"/>
                <ColumnDefinition x:Name="TerminalCol" Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Chat Panel -->
            <Grid Grid.Column="0"
                  Background="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Chat history -->
                <ScrollViewer x:Name="ChatHistory"
                              Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,6">
                    <ItemsControl ItemsSource="{Binding Messages}"
                                  ItemTemplateSelector="{StaticResource ChatTemplateSelector}"/>
                </ScrollViewer>

                <!-- Input bar -->
                <Border Grid.Row="1"
                        Background="#1E1E1E"
                        BorderBrush="#3F3F46"
                        BorderThickness="0,1,0,0"
                        Padding="8,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="ChatInput"
                                 Grid.Column="0"
                                 AcceptsReturn="True"
                                 Height="56"
                                 Background="#252526"
                                 Foreground="#D4D4D4"
                                 CaretBrush="#D4D4D4"
                                 BorderBrush="#3F3F46"
                                 BorderThickness="1"
                                 Padding="8,6"
                                 FontSize="12.5"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 GotFocus="ChatInput_GotFocus"
                                 LostFocus="ChatInput_LostFocus"/>

                        <Button Grid.Column="2"
                                x:Name="SendButton"
                                Content="Send"
                                Width="68"
                                Height="56"
                                Background="#1F69FF"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                FontSize="12.5"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Splitter (visible when terminal open) -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#3F3F46"
                          Visibility="{Binding IsTerminalVisible, Converter={StaticResource BoolToVisConverter}}"/>

            <!-- Terminal / Logs Panel -->
            <Border Grid.Column="2"
                    Width="280"
                    Background="#0D0D0D"
                    BorderBrush="#3F3F46"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding IsTerminalVisible, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#1E1E1E"
                            BorderBrush="#3F3F46"
                            BorderThickness="0,0,0,1"
                            Padding="8,4">
                        <TextBlock Text="Raw Terminal Output"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   Foreground="#9CDCFE"/>
                    </Border>

                    <TextBox Grid.Row="1"
                             x:Name="TerminalOutput"
                             IsReadOnly="True"
                             Background="#0D0D0D"
                             Foreground="#33FF33"
                             CaretBrush="#33FF33"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="11"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Margin="4"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
