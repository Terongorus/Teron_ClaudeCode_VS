<UserControl x:Class="Antigravity_CLI_GUI.AntigravityToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Antigravity_CLI_GUI.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <StackPanel Orientation="Horizontal" Margin="4">
            <TextBlock Text="Antigravity" FontWeight="Bold" Margin="0,0,8,0"/>
            <ComboBox x:Name="ModelSelector" Width="180" Margin="0,0,8,0" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}"/>
            <Button x:Name="NewChatButton" Content="New Chat" Margin="0,0,8,0"/>
            <Button x:Name="OpenTerminalButton" Content="Open Raw Terminal"/>
        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Chat panel -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Chat history with bubbles -->
                    <ScrollViewer x:Name="ChatHistory" Grid.Row="0" Margin="4" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.Resources>
                                <!-- User bubble -->
                                <DataTemplate x:Key="UserTemplate">
                                    <DockPanel LastChildFill="False" Margin="0,4,0,4">
                                        <Border Background="#2D7DFF"
                                                CornerRadius="8"
                                                Padding="8"
                                                Margin="40,0,0,0"
                                                HorizontalAlignment="Right">
                                            <local:MarkdownViewer x:Name="Md" Loaded="OnMarkdownLoaded" MaxWidth="400"/>

                                        </Border>
                                    </DockPanel>
                                </DataTemplate>

                                <!-- Assistant bubble -->
                                <DataTemplate x:Key="AssistantTemplate">
                                    <DockPanel LastChildFill="False" Margin="0,4,0,4">
                                        <Border Background="#EEEEEE"
                                                CornerRadius="8"
                                                Padding="8"
                                                Margin="0,0,40,0"
                                                HorizontalAlignment="Left">
                                            <local:MarkdownViewer x:Name="Md" Loaded="OnMarkdownLoaded" MaxWidth="400"/>
                                        </Border>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Input area -->
                    <DockPanel Grid.Row="1" Margin="4">
                        <TextBox x:Name="ChatInput"
                                 AcceptsReturn="True"
                                 Height="60"
                                 DockPanel.Dock="Left"
                                 Margin="0,0,4,0"
                                 TextWrapping="Wrap"/>
                        <Button x:Name="SendButton"
                                Content="Send"
                                Width="80"/>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Terminal / status / logs -->
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="4">
                <Grid x:Name="TerminalHost">
                    <TextBox x:Name="TerminalOutput"
                 Margin="4"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
