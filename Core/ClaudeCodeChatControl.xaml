<UserControl x:Class="TeronClaudeCodeVS.Core.ClaudeCodeChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:vm="clr-namespace:TeronClaudeCodeVS.ViewModels"
             xmlns:controls="clr-namespace:TeronClaudeCodeVS.Controls"
             Background="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
             MinWidth="220">

    <UserControl.Resources>
        <ResourceDictionary>

            <!--
                ST-1: every brush, font size and corner radius used below is defined once in
                ChatTheme.xaml. Do not reintroduce literals here - see that file's header for the
                rules and for why each token exists.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TeronClaudeCodeVS;component/Core/ChatTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!--
            UX-12 - one modal visual language.

            Every popup in this file previously repeated the same eight attributes by hand, which
            is how they drifted apart (different radii, one without a shadow). They are now one
            style; a popup Border sets only its own size constraints. The audit's finding was that
            baseline's Plugins/Rewind surfaces "read as deliberate modals rather than bare
            dropdowns" - that difference is the shadow, the consistent radius, and the hairline.
        -->
        <Style x:Key="PopupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" Opacity="0.3" ShadowDepth="2" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            UX-6 - keyboard-affordance hints.

            The audit found baseline advertises its shortcuts in the surface that uses them
            ("↑↓ to navigate · Enter to select · Esc to close") while we advertised none anywhere,
            so ours were effectively undiscoverable. Chrome-sized and dimmed: a hint that competes
            with the list it describes is worse than no hint.
        -->
        <Style x:Key="KeyHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeChrome}"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="Margin" Value="8,0,8,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- UX-6: the hairline that separates a picker's list from its hint footer. -->
        <Style x:Key="PopupFooterStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="0,5,0,5"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- Converters -->
        <controls:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <controls:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <controls:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <controls:ToolStatusToBrushConverter x:Key="ToolStatusToBrushConverter"/>
        <controls:EqualityToVisibilityConverter x:Key="EqualityToVisibilityConverter"/>
        <controls:HiddenInSummaryModeConverter x:Key="HiddenInSummaryModeConverter"/>
        <controls:ToolCallExpandableConverter x:Key="ToolCallExpandableConverter"/>
        <controls:StatusLineConverter x:Key="StatusLineConverter"/>
        <controls:FilePathToNameConverter x:Key="FilePathToNameConverter"/>
        <controls:FilePathToDirConverter x:Key="FilePathToDirConverter"/>
        <controls:McpStatusToBrushConverter x:Key="McpStatusToBrushConverter"/>
        <controls:ContextPercentToBrushConverter x:Key="ContextPercentToBrushConverter"/>

        <!-- ListBoxItem style for popups: replaces all WPF system-color defaults with VS theme brushes -->
        <Style x:Key="PopupListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderThickness="0" CornerRadius="{StaticResource RadiusControl}" Margin="2,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ClaudeAccentTintBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBoxItem style for session history: hover highlight, no selection blue -->
        <Style x:Key="SessionListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderThickness="0" CornerRadius="{StaticResource RadiusControl}" Margin="4,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent (Send) button - small filled circle -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ClaudeAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusCircle}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ClaudeAccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stop button - matches the Send circle, neutral color -->
        <Style x:Key="StopButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusCircle}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ErrorBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header icon button (New Session / Settings) -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="{StaticResource GlyphSize}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusControl}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill toggle (Raw output) -->
        <Style x:Key="PillToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeChrome}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusPill}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ClaudeAccentTintBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource ClaudeAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chip button (Active File / Selection / command menu trigger) -->
        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeChrome}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusPill}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource ClaudeAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Full-width flat row button (command menu items) -->
        <Style x:Key="MenuRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusControl}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small-caps section header inside the command menu -->
        <Style x:Key="MenuSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeChrome}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Margin" Value="8,8,8,2"/>
        </Style>

        <!-- Secondary outlined button (permission prompts, neutral actions) -->
        <!--
          Primary accent-colored text button (Allow / Submit / Try again / plan-approval actions).
          Deliberately separate from AccentButtonStyle below, which is a fixed 30x30 circular
          icon-button style built only for the Send button - every text-button consumer that
          reused AccentButtonStyle had to remember to locally override Width/Height back to Auto
          (easy to forget, as a freshly-added plan-approval button just demonstrated), and its
          ContentPresenter never honored Padding at all. This style auto-sizes to content like
          SecondaryButtonStyle, so callers only need Padding/Margin/alignment.
        -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ClaudeAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusControl}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ClaudeAccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusControl}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Deny button: outlined with error tint (permission prompts) -->
        <Style x:Key="DenyButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
        </Style>

        <!-- Usage progress bar: replaces default WPF ProgressBar system-color template -->
        <Style x:Key="UsageBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ClaudeAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusControl}">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="{StaticResource RadiusControl}"
                                    Background="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Reusable menu-row item: option DisplayName + checkmark when selected.

            UX-1/UX-2: rows are now two lines. Without the subtitle the picker was a bare name
            list, so a user could not see from it that switching to Opus roughly doubles usage, or
            what "Don't Ask" actually does. The subtitle wraps rather than truncates - a cost
            warning cut off mid-sentence is worse than a taller row.
        -->
        <DataTemplate x:Key="ModelMenuItemTemplate">
            <Button Style="{StaticResource MenuRowButtonStyle}" Click="OnModelOptionClicked">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding DisplayName}"/>
                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSizeChrome}"
                                   Opacity="0.6" TextWrapping="Wrap" Margin="0,1,0,0"
                                   Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="✓" FontWeight="Bold" Margin="10,0,0,0"
                               VerticalAlignment="Top"
                               Foreground="{StaticResource ClaudeAccentBrush}">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource EqualityToVisibilityConverter}">
                                <Binding/>
                                <Binding Path="DataContext.SelectedModel" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="PermissionMenuItemTemplate">
            <Button Style="{StaticResource MenuRowButtonStyle}" Click="OnPermissionOptionClicked">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding DisplayName}"/>
                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSizeChrome}"
                                   Opacity="0.6" TextWrapping="Wrap" Margin="0,1,0,0"
                                   Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="✓" FontWeight="Bold" Margin="10,0,0,0"
                               VerticalAlignment="Top"
                               Foreground="{StaticResource ClaudeAccentBrush}">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource EqualityToVisibilityConverter}">
                                <Binding/>
                                <Binding Path="DataContext.SelectedPermissionMode" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ThinkingMenuItemTemplate">
            <Button Style="{StaticResource MenuRowButtonStyle}" Click="OnThinkingOptionClicked">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}"/>
                    <TextBlock Grid.Column="1" Text="✓" FontWeight="Bold" Margin="10,0,0,0"
                               Foreground="{StaticResource ClaudeAccentBrush}">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource EqualityToVisibilityConverter}">
                                <Binding/>
                                <Binding Path="DataContext.SelectedThinkingLevel" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="TranscriptModeMenuItemTemplate">
            <Button Style="{StaticResource MenuRowButtonStyle}" Click="OnTranscriptModeOptionClicked">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}"/>
                    <TextBlock Grid.Column="1" Text="✓" FontWeight="Bold" Margin="10,0,0,0"
                               Foreground="{StaticResource ClaudeAccentBrush}">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource EqualityToVisibilityConverter}">
                                <Binding/>
                                <Binding Path="DataContext.CurrentTranscriptMode" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SlashCommandMenuItemTemplate">
            <Button Style="{StaticResource MenuRowButtonStyle}" Click="OnSlashCommandMenuItemClicked">
                <TextBlock Text="{Binding StringFormat=/{0}}" FontFamily="Consolas" FontSize="{StaticResource FontSizeChrome}"/>
            </Button>
        </DataTemplate>

        <!-- GAP-1: one Customize row per terminal hand-off entry. -->
        <DataTemplate x:Key="TerminalHandoffMenuItemTemplate" DataType="{x:Type vm:TerminalHandoffEntry}">
            <Button Style="{StaticResource MenuRowButtonStyle}" Click="OnTerminalHandoffClicked">
                <StackPanel>
                    <TextBlock Text="{Binding Label}"/>
                    <TextBlock Text="{Binding MenuDescription}" FontSize="{StaticResource FontSizeChrome}"
                               Opacity="0.6" TextWrapping="Wrap" Margin="0,1,0,0"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!--
            FEAT-5: one row per plugin, shared by the panel's Installed and Available lists. An
            installed row has no description of its own - only the marketplace catalog carries one -
            so the detail line does the work instead (version, marketplace, scope, enablement).
        -->
        <DataTemplate x:Key="PluginRowTemplate" DataType="{x:Type vm:PluginEntry}">
            <StackPanel Margin="0,4,0,4">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSizeChrome}"
                           Opacity="0.75" TextWrapping="Wrap" Margin="0,1,0,0"
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                           Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="{Binding DetailLine}" FontSize="{StaticResource FontSizeChrome}"
                           Opacity="0.55" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- ===================== Content-block templates ===================== -->

        <DataTemplate x:Key="TextBlockTemplate" DataType="{x:Type vm:TextBlockViewModel}">
            <controls:MarkdownViewer/>
        </DataTemplate>

        <DataTemplate x:Key="ImageAttachmentTemplate" DataType="{x:Type vm:ImageAttachmentViewModel}">
            <Border CornerRadius="{StaticResource RadiusCard}" Margin="0,0,0,6" MaxWidth="260" ClipToBounds="True">
                <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxHeight="200"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FileAttachmentTemplate" DataType="{x:Type vm:FileAttachmentViewModel}">
            <Border CornerRadius="{StaticResource RadiusControl}" Margin="0,0,0,6" Padding="6,3" Background="#22FFFFFF">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📄" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSizeBody}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ThinkingBlockTemplate" DataType="{x:Type vm:ThinkingBlockViewModel}">
            <Expander IsExpanded="{Binding IsExpanded}" Margin="0,2,0,2" Opacity="0.75"
                      Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                      Expanded="OnCardExpanderToggled" Collapsed="OnCardExpanderToggled"
                      Visibility="{Binding DataContext.CurrentTranscriptMode.Value,
                                   RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2},
                                   Converter={StaticResource HiddenInSummaryModeConverter}}">
                <Expander.Header>
                    <TextBlock Text="Thinking" FontStyle="Italic" FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                </Expander.Header>
                <controls:MarkdownViewer Margin="18,4,0,2"/>
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="ToolCallTemplate" DataType="{x:Type vm:ToolCallViewModel}">
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Margin="0,3,0,3">
                <Expander IsExpanded="{Binding IsExpanded}" Padding="2"
                          Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                          Expanded="OnCardExpanderToggled" Collapsed="OnCardExpanderToggled">
                    <Expander.IsEnabled>
                        <MultiBinding Converter="{StaticResource ToolCallExpandableConverter}">
                            <Binding Path="HasDetail"/>
                            <Binding Path="DataContext.CurrentTranscriptMode.Value"
                                     RelativeSource="{RelativeSource AncestorType=ItemsControl, AncestorLevel=2}"/>
                        </MultiBinding>
                    </Expander.IsEnabled>
                    <Expander.Header>
                        <Grid Margin="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Icon}" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Summary}" Opacity="0.7"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                            <TextBlock Grid.Column="3" Text="{Binding StatusGlyph}" FontWeight="Bold"
                                       Margin="6,0,4,0" VerticalAlignment="Center"
                                       Foreground="{Binding Status, Converter={StaticResource ToolStatusToBrushConverter}}"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="22,4,4,4">
                        <!--
                            FEAT-2: the same comparison the chat card shows inline, in a real VS
                            diff tab. Visible only for Edit/Write - see VsDiffTab for the rest.
                        -->
                        <Button Content="Open diff tab" Click="OnOpenDiffTabClicked"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,3" FontSize="{StaticResource FontSizeChrome}"
                                HorizontalAlignment="Left" Margin="0,0,0,6"
                                AutomationProperties.AutomationId="ToolCallOpenDiffTab"
                                Visibility="{Binding CanOpenDiffTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <controls:DiffViewer RawDiff="{Binding RawDiff}"
                                              Visibility="{Binding RawDiff, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <controls:MarkdownViewer
                                              Visibility="{Binding HasMarkdownDetail, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AskUserQuestionTemplate" DataType="{x:Type vm:AskUserQuestionViewModel}">
            <Border Background="{StaticResource ClaudeAccentTintBrush}"
                    BorderBrush="{StaticResource ClaudeAccentBrush}"
                    TextElement.Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Margin="0,4,0,4" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="Claude has a question" FontWeight="SemiBold" Margin="0,0,0,8"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>

                    <ItemsControl ItemsSource="{Binding QuestionAnswers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:QuestionAnswerViewModel}">
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Question.QuestionText}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,0,0,4"
                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>

                                    <!-- Option list (single-select, radio buttons) -->
                                    <ItemsControl ItemsSource="{Binding Options}"
                                                  Visibility="{Binding IsSingleSelectWithOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SelectableOptionViewModel}">
                                                <RadioButton GroupName="{Binding RadioGroupName}"
                                                             IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,3,0,3">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeBody}"
                                                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSizeChrome}" Opacity="0.6"
                                                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                                                   Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Option list (multi-select, checkboxes) -->
                                    <ItemsControl ItemsSource="{Binding Options}"
                                                  Visibility="{Binding IsMultiSelect, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SelectableOptionViewModel}">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,3,0,3">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeBody}"
                                                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSizeChrome}" Opacity="0.6"
                                                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                                                   Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Free-text input (when no options) -->
                                    <TextBox Text="{Binding AnswerText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,2,0,0" Padding="4,4" FontSize="{StaticResource FontSizeBody}"
                                             BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                             Background="Transparent"
                                             Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                             CaretBrush="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                             Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <Button Content="Submit" Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Top"
                                Padding="14,6" Margin="0,0,8,0" MinWidth="72"/>
                        <Button Content="Skip" Command="{Binding SkipCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                Width="Auto" Height="Auto" VerticalAlignment="Top"
                                Padding="14,6" MinWidth="60"/>
                    </StackPanel>

                    <!-- Resolution text -->
                    <TextBlock Text="{Binding ResolutionText}" FontStyle="Italic" Opacity="0.7" Margin="0,8,0,0"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                               Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PermissionTemplate" DataType="{x:Type vm:PermissionRequestViewModel}">
            <Border Background="{StaticResource ClaudeAccentTintBrush}"
                    BorderBrush="{StaticResource ClaudeAccentBrush}"
                    TextElement.Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Margin="0,4,0,4" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,0"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>

                    <!--
                        UX-3: the full absolute path. Summary abbreviates for readability, which is
                        right everywhere except here - the audit found baseline states the whole
                        path on an approval prompt, and it should: this is the moment the user
                        decides whether a write lands where they think it does.
                    -->
                    <TextBlock Text="{Binding FullPath}" FontFamily="Consolas"
                               FontSize="{StaticResource FontSizeChrome}" Opacity="0.7"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                               Visibility="{Binding FullPath, Converter={StaticResource NullToVisibilityConverter}}"/>

                    <!--
                        FEAT-2: opens the proposed change as a real side-by-side VS tab before the
                        user answers. Accept/Deny deliberately stay here on the card - VS's
                        difference window is read-only browsing UI and takes no custom commands.
                    -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="{Binding CanOpenDiffTab, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="Open diff tab" Click="OnOpenDiffTabClicked"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,3" FontSize="{StaticResource FontSizeChrome}"
                                AutomationProperties.AutomationId="PermissionOpenDiffTab"/>
                    </StackPanel>

                    <controls:DiffViewer Margin="0,6,0,0" RawDiff="{Binding RawDiff}"
                                          Visibility="{Binding RawDiff, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <controls:MarkdownViewer Margin="0,6,0,0"
                                              Visibility="{Binding HasMarkdownDetail, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!--
                        UX-3: numbered actions. The numbers are not decoration - 1/2/3 and Esc are
                        live while this card is the pending one and the input box is empty (see
                        OnInputPreviewKeyDown), so the label is what makes the shortcut findable.
                    -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <Button Content="1  Allow" Command="{Binding AllowCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Top"
                                Padding="14,6" Margin="0,0,8,0" MinWidth="72"/>
                        <Button Content="2  Allow for Session" Command="{Binding AllowForSessionCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="Auto" Height="Auto" VerticalAlignment="Top"
                                Padding="14,6" Margin="0,0,8,0" MinWidth="120"/>
                        <Button Content="3  Deny" Command="{Binding DenyCommand}"
                                Style="{StaticResource DenyButtonStyle}"
                                MinWidth="72" Padding="14,6"/>
                    </StackPanel>

                    <!-- UX-3: redirect instead of a dead-end deny. -->
                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Tell Claude what to do instead"
                                    Command="{Binding ToggleRedirectCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="8,3" FontSize="{StaticResource FontSizeChrome}"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.AutomationId="PermissionRedirectToggle"/>
                            <TextBlock Text="1 / 2 / 3 to choose · Esc to cancel"
                                       Style="{StaticResource KeyHintStyle}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,6,0,0"
                              Visibility="{Binding IsRedirectVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusControl}" Padding="6,3" Margin="0,0,6,0">
                                <TextBox Text="{Binding RedirectText, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                         AcceptsReturn="False" MinHeight="20"
                                         Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                         CaretBrush="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                         FontSize="{StaticResource FontSizeBody}"
                                         AutomationProperties.AutomationId="PermissionRedirectBox"/>
                            </Border>
                            <Button Grid.Column="1" Content="Send" Command="{Binding SendRedirectCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="12,4"
                                    AutomationProperties.AutomationId="PermissionRedirectSend"/>
                        </Grid>
                    </StackPanel>
                    <TextBlock Text="{Binding ResolutionText}" FontStyle="Italic" Opacity="0.7" Margin="0,8,0,0"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                               Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PlanApprovalTemplate" DataType="{x:Type vm:PlanApprovalViewModel}">
            <Border Background="{StaticResource ClaudeAccentTintBrush}"
                    BorderBrush="{StaticResource ClaudeAccentBrush}"
                    TextElement.Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Margin="0,4,0,4" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="Accept this plan?" FontWeight="SemiBold"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                    <TextBlock Text="Select text in the plan tab to add comments" Opacity="0.7" Margin="0,2,0,0"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                    <Button Content="Reopen plan tab" Command="{Binding ReopenTabCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"
                            Padding="8,3" FontSize="{StaticResource FontSizeChrome}" Margin="0,6,0,0"/>

                    <!-- Staged comments (added from the plan tab's selection adornment) -->
                    <StackPanel Visibility="{Binding HasComments, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,10,0,0">
                        <TextBlock Text="{Binding Comments.Count, StringFormat='Comments ({0})'}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                        <ItemsControl ItemsSource="{Binding Comments}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PlanCommentEntry}">
                                    <Border Background="{StaticResource CardBackgroundBrush}"
                                            BorderBrush="{StaticResource HairlineBrush}"
                                            BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="8,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding QuotedExcerpt, StringFormat='&quot;{0}&quot;'}"
                                                           FontStyle="Italic" Opacity="0.7" TextWrapping="Wrap" FontSize="{StaticResource FontSizeChrome}"
                                                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                                <TextBlock Text="{Binding CommentText}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="✕" Command="{Binding RemoveCommand}"
                                                    AutomationProperties.Name="Remove comment"
                                                    Background="Transparent" BorderThickness="0" Padding="4,0"
                                                    VerticalAlignment="Top" Opacity="0.6"
                                                    Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Action area: hidden entirely once resolved -->
                    <StackPanel Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <!-- Default actions: no comments staged yet -->
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding HasComments, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                            <Button Content="Yes, and auto-accept" Command="{Binding AutoAcceptCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Padding="14,8" Margin="0,0,0,6"/>
                            <Button Content="Yes, and manually approve edits" Command="{Binding ManuallyApproveCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Padding="14,8" Margin="0,0,0,6"/>
                            <Button Content="No, keep planning" Command="{Binding KeepPlanningCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Padding="14,8"/>
                        </StackPanel>

                        <!-- Comments staged: primary action collapses to a single send-feedback button -->
                        <StackPanel Visibility="{Binding HasComments, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,10,0,0">
                            <TextBlock Text="Continue planning" FontWeight="SemiBold"
                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                            <TextBlock Text="{Binding Comments.Count, StringFormat='{}{0} comment(s) will be included as feedback'}"
                                       Opacity="0.7" Margin="0,2,0,6"
                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                            <Button Content="Send feedback and keep planning" Command="{Binding SendFeedbackCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Padding="14,8"/>
                        </StackPanel>

                        <!-- Below the action button(s), matching the real extension's layout -->
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Tell Claude what to do instead" FontSize="{StaticResource FontSizeChrome}" Opacity="0.6"
                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                            <TextBox Text="{Binding FeedbackText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,2,0,0" Padding="4,4" FontSize="{StaticResource FontSizeBody}"
                                     BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                     Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="80"
                                     Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                     CaretBrush="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding ResolutionText}" FontStyle="Italic" Opacity="0.7" Margin="0,8,0,0"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                               Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ResultFooterTemplate" DataType="{x:Type vm:ResultFooterViewModel}">
            <TextBlock Text="{Binding Text}" FontSize="{StaticResource FontSizeChrome}" Opacity="0.6" Margin="2,4,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                <Setter Property="Opacity" Value="0.9"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="InterruptedTemplate" DataType="{x:Type vm:InterruptedBlockViewModel}">
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Margin="0,4,0,4" Padding="8,6">
                <TextBlock Text="⏹ Response interrupted" FontStyle="Italic" Opacity="0.6" FontSize="{StaticResource FontSizeBody}"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RetryTemplate" DataType="{x:Type vm:RetryNoticeViewModel}">
            <StackPanel Margin="0,4,0,4" HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding Text}" FontSize="{StaticResource FontSizeBody}" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Button Content="Resend" ToolTip="Resends your original message verbatim as a new turn"
                        Command="{Binding RetryCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="14,8"/>
            </StackPanel>
        </DataTemplate>

        <!--
            GAP-1 / GAP-3: the shared two-choice card. Deliberately built out of the permission
            card's parts - same tinted border, same numbered-action convention, same italic
            resolution line - because it answers the same kind of question ("do this, yes or
            no?") and a second visual language for that would be noise. See UX-12.
        -->
        <DataTemplate x:Key="ChoiceCardTemplate" DataType="{x:Type vm:ChoiceCardViewModel}">
            <Border Background="{StaticResource ClaudeAccentTintBrush}"
                    BorderBrush="{StaticResource ClaudeAccentBrush}"
                    TextElement.Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusControl}"
                    Margin="0,4,0,4" Padding="10,8" MaxWidth="520">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                               AutomationProperties.AutomationId="ChoiceCardTitle"/>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,0"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                    <TextBlock Text="{Binding Detail}" FontFamily="Consolas"
                               FontSize="{StaticResource FontSizeChrome}" Opacity="0.7"
                               TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                               Visibility="{Binding Detail, Converter={StaticResource NullToVisibilityConverter}}"
                               AutomationProperties.AutomationId="ChoiceCardDetail"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <Button Content="{Binding PrimaryLabel}" Command="{Binding PrimaryCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="Auto" Height="Auto" VerticalAlignment="Top"
                                Padding="14,6" Margin="0,0,8,0"
                                AutomationProperties.AutomationId="ChoiceCardPrimary"/>
                        <Button Content="{Binding SecondaryLabel}" Command="{Binding SecondaryCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="Auto" Height="Auto" VerticalAlignment="Top"
                                Padding="14,6" Margin="0,0,8,0"
                                AutomationProperties.AutomationId="ChoiceCardSecondary"/>
                        <TextBlock Text="1 / 2 to choose" Style="{StaticResource KeyHintStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ResolutionText}" FontStyle="Italic" Opacity="0.7"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                               Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibilityConverter}}"
                               AutomationProperties.AutomationId="ChoiceCardResolution"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--
            GAP-3 `/btw`. Rendered as its own quiet card rather than as a normal turn, because
            that is what it is: the CLI answers it out-of-band and never writes it into the
            session transcript, so styling it like an assistant reply would misrepresent what the
            conversation actually contains.
        -->
        <DataTemplate x:Key="SideQuestionTemplate" DataType="{x:Type vm:SideQuestionViewModel}">
            <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                    TextElement.Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                    CornerRadius="{StaticResource RadiusCard}" Margin="0,4,0,4" Padding="10,8"
                    MaxWidth="620">
                <StackPanel>
                    <TextBlock Text="Side question" FontSize="{StaticResource FontSizeChrome}"
                               Opacity="0.55" FontWeight="SemiBold"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                               AutomationProperties.AutomationId="SideQuestionHeader"/>
                    <TextBlock Text="{Binding Question}" TextWrapping="Wrap" FontWeight="SemiBold"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                    <TextBlock Text="{Binding StatusText}" FontStyle="Italic" Opacity="0.7"
                               TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                               Visibility="{Binding StatusText, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <controls:MarkdownViewer Margin="0,6,0,0"
                                             Visibility="{Binding HasAnswer, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="Answered out of band - not added to the conversation."
                               Style="{StaticResource KeyHintStyle}" Margin="0,4,0,0"
                               Visibility="{Binding HasAnswer, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <controls:ContentBlockTemplateSelector x:Key="BlockTemplateSelector"
            TextTemplate="{StaticResource TextBlockTemplate}"
            ImageAttachmentTemplate="{StaticResource ImageAttachmentTemplate}"
            FileAttachmentTemplate="{StaticResource FileAttachmentTemplate}"
            ThinkingTemplate="{StaticResource ThinkingBlockTemplate}"
            ToolCallTemplate="{StaticResource ToolCallTemplate}"
            PermissionTemplate="{StaticResource PermissionTemplate}"
            PlanApprovalTemplate="{StaticResource PlanApprovalTemplate}"
            AskUserQuestionTemplate="{StaticResource AskUserQuestionTemplate}"
            ResultTemplate="{StaticResource ResultFooterTemplate}"
            InterruptedTemplate="{StaticResource InterruptedTemplate}"
            RetryTemplate="{StaticResource RetryTemplate}"
            ChoiceCardTemplate="{StaticResource ChoiceCardTemplate}"
            SideQuestionTemplate="{StaticResource SideQuestionTemplate}"/>

        <!-- ===================== Message templates ===================== -->

        <!--
            ST-5 - DELIBERATE DIVERGENCE FROM THE MEASURED BASELINE. DO NOT "FIX".

            The 2026-08-28 live audit found that the official VS Code extension renders user
            messages with no bubble at all - plain text, left-aligned, distinguished only by
            weight. Our right-aligned terracotta bubble was raised as a style gap (ST-5) and was
            explicitly kept: the asymmetry makes turn boundaries readable at a glance when the
            tool window is docked narrow, which is the common case in Visual Studio and not the
            common case in VS Code's wider sidebar.

            Because the fill is the accent, this is the one place the brand colour carries a large
            surface area, and the 10,10,2,10 radius is the tail - both are intentionally literal
            here rather than tokenised, so that a future pass over ChatTheme.xaml cannot change
            them by accident.
        -->
        <DataTemplate x:Key="UserMessageTemplate" DataType="{x:Type vm:ChatMessageViewModel}">
            <!--
                FEAT-1's per-message affordance. Baseline reveals a `…` on hover beside each user
                message and offers the same three actions its picker does; this is that, kept
                outside the bubble so the terracotta fill stays a clean shape. It is transparent
                rather than collapsed when not hovered, exactly as baseline's is - which also means
                it is a real element in the automation tree at all times, so a live test can reach
                it without simulating a mouse.
            -->
            <Grid x:Name="UserRow" HorizontalAlignment="Right" Margin="48,4,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="MessageActionsButton" Grid.Column="0" Content="…"
                        Style="{StaticResource IconButtonStyle}" Width="20" Height="20"
                        VerticalAlignment="Top" Margin="0,2,4,0" Opacity="0"
                        FontSize="{StaticResource GlyphSize}"
                        Click="OnMessageActionsClicked" Tag="{Binding}"
                        ToolTip="Rewind or fork from this message"
                        AutomationProperties.AutomationId="MessageActionsButton"
                        AutomationProperties.Name="Message actions"/>

                <Border Grid.Column="1" Background="{StaticResource ClaudeAccentBrush}"
                        TextElement.Foreground="White"
                        CornerRadius="10,10,2,10" Padding="10,6"
                        MaxWidth="460">
                    <ItemsControl ItemsSource="{Binding Blocks}" ItemTemplateSelector="{StaticResource BlockTemplateSelector}"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="UserRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="MessageActionsButton" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AssistantMessageTemplate" DataType="{x:Type vm:ChatMessageViewModel}">
            <StackPanel Margin="2,4,12,4">
                <!--
                    UX-7: grouped count + failure state for the turn's tool calls, so a failure in
                    a run of otherwise identical collapsed rows is visible without expanding any of
                    them. Hidden for a single successful call, where it would only restate the card
                    directly beneath it - see ChatMessageViewModel.ToolCallSummary.
                -->
                <TextBlock Text="{Binding ToolCallSummary}" FontSize="{StaticResource FontSizeChrome}"
                           Opacity="0.6" Margin="4,0,0,2"
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                           Visibility="{Binding ToolCallSummary, Converter={StaticResource NullToVisibilityConverter}}"/>
                <ItemsControl ItemsSource="{Binding Blocks}" ItemTemplateSelector="{StaticResource BlockTemplateSelector}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SystemMessageTemplate" DataType="{x:Type vm:ChatMessageViewModel}">
            <ItemsControl ItemsSource="{Binding Blocks}" ItemTemplateSelector="{StaticResource BlockTemplateSelector}"
                          HorizontalAlignment="Center" Margin="0,2,0,2"/>
        </DataTemplate>

        <controls:ChatMessageTemplateSelector x:Key="MessageTemplateSelector"
            UserTemplate="{StaticResource UserMessageTemplate}"
            AssistantTemplate="{StaticResource AssistantMessageTemplate}"
            SystemTemplate="{StaticResource SystemMessageTemplate}"/>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Header ===================== -->
        <Border Grid.Row="0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="{StaticResource RadiusControl}"
                        Background="{StaticResource ClaudeAccentBrush}" VerticalAlignment="Center">
                    <TextBlock Text="✳" FontSize="{StaticResource GlyphSize}" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Column="1" Text="Claude Code" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>

                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                        Click="OnNewSessionClicked" Margin="2,0" VerticalAlignment="Center"
                        ToolTip="Start a new Claude Code session"
                        AutomationProperties.AutomationId="NewSessionButton"
                        AutomationProperties.Name="New session">
                    <TextBlock Text="✚"/>
                </Button>

                <Button Grid.Column="3" x:Name="HistoryButton" Style="{StaticResource IconButtonStyle}"
                        Click="OnHistoryClicked" Margin="2,0" VerticalAlignment="Center"
                        ToolTip="Session history"
                        AutomationProperties.AutomationId="HistoryButton"
                        AutomationProperties.Name="Session history">
                    <TextBlock Text="☰"/>
                </Button>

                <ToggleButton Grid.Column="4" Content="Raw" Style="{StaticResource PillToggleStyle}"
                               IsChecked="{Binding IsRawOutputVisible}"
                               Margin="2,0" VerticalAlignment="Center"
                               ToolTip="Show raw CLI output"
                               AutomationProperties.AutomationId="RawToggleButton"/>

                <Button Grid.Column="5" x:Name="TranscriptModeButton" Style="{StaticResource ChipButtonStyle}"
                        Click="OnTranscriptModeClicked" Margin="2,0" VerticalAlignment="Center"
                        Padding="7,2" FontSize="{StaticResource FontSizeChrome}"
                        ToolTip="Transcript detail level: how much of each turn is shown"
                        AutomationProperties.AutomationId="TranscriptModeButton">
                    <TextBlock Text="{Binding CurrentTranscriptMode.DisplayName}"/>
                </Button>

                <Popup x:Name="TranscriptModePopup" PlacementTarget="{Binding ElementName=TranscriptModeButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       AutomationProperties.AutomationId="TranscriptModePopup">
                    <Border Style="{StaticResource PopupCardStyle}" MinWidth="180" Margin="0,4,0,0">
                        <StackPanel Margin="2,4">
                            <TextBlock Text="TRANSCRIPT" Style="{StaticResource MenuSectionHeaderStyle}"/>
                            <ItemsControl ItemsSource="{Binding TranscriptModes}" ItemTemplate="{StaticResource TranscriptModeMenuItemTemplate}"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <Button Grid.Column="6" Style="{StaticResource IconButtonStyle}"
                        Click="OnSettingsClicked" Margin="2,0,0,0" VerticalAlignment="Center"
                        ToolTip="Claude Code settings"
                        AutomationProperties.AutomationId="SettingsButton"
                        AutomationProperties.Name="Claude Code settings">
                    <TextBlock Text="⚙"/>
                </Button>
            </Grid>
        </Border>

        <!-- ===================== Status strip ===================== -->
        <Border Grid.Row="1" Padding="10,2">
            <TextBlock FontSize="{StaticResource FontSizeChrome}" Opacity="0.65">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource StatusLineConverter}">
                        <Binding Path="IsBusy"/>
                        <Binding Path="ElapsedText"/>
                        <Binding Path="SessionTokensShortText"/>
                        <Binding Path="RunningTaskCount"/>
                        <Binding Path="StatusText"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Border>

        <!-- ===================== Main content ===================== -->
        <!-- ===================== Running tasks panel ===================== -->
        <!-- Original design - the real VS Code extension has no equivalent UI at all, only an
             internal backgroundTasks/stopTask protocol handshake with nothing user-facing
             (confirmed via direct research against the installed bundle, 2026-08-27). Auto-shows
             whenever at least one tool call is Running rather than needing a manual toggle, since
             the point is visibility into work already happening in the background. -->
        <Border Grid.Row="2" x:Name="RunningTasksPanel" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1"
                Padding="10,4" Visibility="{Binding HasRunningTasks, Converter={StaticResource BoolToVisibilityConverter}}"
                AutomationProperties.AutomationId="RunningTasksPanel">
            <StackPanel>
                <TextBlock Text="{Binding RunningTaskCount, StringFormat='Running tasks ({0})'}"
                           FontSize="{StaticResource FontSizeChrome}" Opacity="0.55" Margin="0,0,0,3"
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                <ItemsControl ItemsSource="{Binding RunningToolCalls}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ToolCallViewModel}">
                            <Button Click="OnJumpToRunningTaskClicked" Tag="{Binding}"
                                    Style="{StaticResource MenuRowButtonStyle}" Padding="4,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" Margin="0,0,6,0"
                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="{StaticResource FontSizeChrome}"
                                               Margin="0,0,6,0"
                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="{StaticResource FontSizeChrome}" Opacity="0.6"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding ElapsedText}" FontSize="{StaticResource FontSizeChrome}" Opacity="0.6"
                                               Margin="6,0,0,0"
                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <ScrollViewer x:Name="ChatScrollViewer"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True"
                          Padding="10,4" ScrollChanged="OnChatScrollChanged"
                          Visibility="{Binding ClaudeNotFoundMessage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                <!--
                    UI virtualization (2026-09-05): this ItemsControl was a plain StackPanel-backed
                    list with every message realized at once, each holding one or more
                    FlowDocumentScrollViewers (see Controls/MarkdownViewer.xaml) - one of WPF's most
                    expensive controls to lay out, since a FlowDocument repaginates on every measure
                    pass. In a long conversation this made ANY full-tree layout pass slow - resizing
                    the docked pane, or switching away from and back to its tab (which fires
                    Unloaded/Loaded on the whole tree, invalidating layout for every message even
                    though none of their content changed). VirtualizingStackPanel + ScrollUnit=Pixel
                    keeps the exact same continuous pixel-based scrolling this control's code
                    already depends on (ScrollToEnd, VerticalOffset math in OnChatScrollChanged) but
                    means off-screen messages are never realized, so a resize or tab switch only
                    re-lays-out what's actually visible instead of the entire history.
                -->
                <ItemsControl x:Name="MessageList" ItemsSource="{Binding Messages}" ItemTemplateSelector="{StaticResource MessageTemplateSelector}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              AutomationProperties.AutomationId="MessageList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!--
                UX-11: designed empty state.

                A new session opened onto a blank rectangle, which reads as "not loaded" rather
                than "ready". Baseline fills the same space with a wordmark, a mascot and a tip.
                We do not ship baseline's pixel-art robot - that is their brand asset, not ours -
                so this uses the same accent mark the header already carries, plus the one thing a
                first-time user most needs to know: that @ and / exist.
            -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320"
                        Margin="24" IsHitTestVisible="False"
                        Visibility="{Binding Messages.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <Border Width="40" Height="40" CornerRadius="{StaticResource RadiusCard}"
                        Background="{StaticResource ClaudeAccentBrush}" HorizontalAlignment="Center">
                    <TextBlock Text="✳" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!--
                    The AutomationId sits on this TextBlock rather than on the panel: WPF Panels
                    are not in the UIA control view, so an id there is invisible to the harness
                    (found the hard way during Phase C verification).
                -->
                <TextBlock Text="Claude Code" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"
                           HorizontalAlignment="Center" Margin="0,10,0,0"
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                           AutomationProperties.AutomationId="EmptyStateTitle"/>
                <TextBlock Text="Ask about this solution, or describe a change to make."
                           TextAlignment="Center" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0"
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                <TextBlock Text="@ to attach a file · / for a command"
                           Style="{StaticResource KeyHintStyle}" TextAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

            <Border Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"
                    Visibility="{Binding ClaudeNotFoundMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Claude Code CLI not found" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"
                               HorizontalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ClaudeNotFoundMessage}" TextWrapping="Wrap"
                               TextAlignment="Center" Opacity="0.85"/>
                </StackPanel>
            </Border>

            <!-- ===================== Session History Overlay ===================== -->
            <Border Background="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}"
                    TextElement.Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                    Visibility="{Binding IsSessionHistoryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- FEAT-9: the Local/Running/Cloud tab strip. -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="10,10,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Session History" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource IconButtonStyle}"
                                Click="OnCloseHistoryClicked" Width="22" Height="22" FontSize="{StaticResource GlyphSize}"
                                AutomationProperties.AutomationId="CloseHistoryButton"
                                AutomationProperties.Name="Close session history"/>
                    </Grid>


                    <!--
                        FEAT-9. Baseline's history has a Local/Web pair. Ours splits Web into the two
                        things the CLI can actually do - see AgentSessionsViewModel for why there is
                        no third thing, and why the Cloud tab hands off rather than streaming.
                        Same underline-marks-the-active-tab idiom as the plugins panel (FEAT-5).
                    -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="0,0,0,1" Margin="10,0,10,6">
                        <StackPanel Orientation="Horizontal">
                            <Grid Margin="0,0,4,0">
                                <Button Style="{StaticResource ChipButtonStyle}" Click="OnHistoryLocalTabClicked"
                                        BorderThickness="0" Background="Transparent"
                                        AutomationProperties.AutomationId="HistoryLocalTabButton">
                                    <TextBlock Text="Local"/>
                                </Button>
                                <Border Height="2" VerticalAlignment="Bottom" Background="{StaticResource ClaudeAccentBrush}"
                                        Visibility="{Binding IsLocalTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                            <Grid Margin="0,0,4,0">
                                <Button Style="{StaticResource ChipButtonStyle}" Click="OnHistoryRunningTabClicked"
                                        BorderThickness="0" Background="Transparent"
                                        AutomationProperties.AutomationId="HistoryRunningTabButton">
                                    <TextBlock Text="Running"/>
                                </Button>
                                <Border Height="2" VerticalAlignment="Bottom" Background="{StaticResource ClaudeAccentBrush}"
                                        Visibility="{Binding IsRunningTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                            <Grid>
                                <Button Style="{StaticResource ChipButtonStyle}" Click="OnHistoryCloudTabClicked"
                                        BorderThickness="0" Background="Transparent"
                                        AutomationProperties.AutomationId="HistoryCloudTabButton">
                                    <TextBlock Text="Cloud"/>
                                </Button>
                                <Border Height="2" VerticalAlignment="Bottom" Background="{StaticResource ClaudeAccentBrush}"
                                        Visibility="{Binding IsCloudTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Margin="10,0,10,8"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}"
                            Visibility="{Binding IsLocalTab, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⌕" Margin="8,0,4,0" VerticalAlignment="Center"
                                       Opacity="0.5" FontSize="{StaticResource GlyphSize}"
                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                            <Grid Grid.Column="1">
                                <TextBox x:Name="SessionSearchBox" BorderThickness="0" Background="Transparent"
                                         Padding="2,5" FontSize="{StaticResource FontSizeBody}"
                                         Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                         CaretBrush="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                         TextChanged="OnSessionSearchChanged"
                                         AutomationProperties.AutomationId="SessionSearchBox"/>
                                <TextBlock IsHitTestVisible="False" Text="Search sessions…" Opacity="0.4"
                                           Margin="2,5,2,5" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SessionSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="3" x:Name="SessionListBox"
                             ItemsSource="{Binding SessionHistory}"
                             Visibility="{Binding IsLocalTab, Converter={StaticResource BoolToVisibilityConverter}}"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource SessionListItemStyle}"
                             AutomationProperties.AutomationId="SessionListBox">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SessionHistoryEntry}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Title text (click to resume) -->
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="{StaticResource FontSizeBody}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Cursor="Hand" MouseLeftButtonUp="OnSessionItemClicked"
                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Inline title editor -->
                                    <TextBox Grid.Column="0" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="{StaticResource FontSizeBody}" BorderThickness="0,0,0,1"
                                             BorderBrush="{StaticResource ClaudeAccentBrush}"
                                             Background="Transparent" Padding="0,1"
                                             Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                             CaretBrush="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                             KeyDown="OnSessionTitleKeyDown" LostFocus="OnSessionTitleLostFocus">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <!-- Time ago (hidden while editing) -->
                                    <TextBlock Grid.Column="1" Text="{Binding TimeAgo}" FontSize="{StaticResource FontSizeChrome}" Opacity="0.55"
                                               VerticalAlignment="Center" Margin="0,0,4,0"
                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Edit + Delete (visible on row hover, hidden while editing) -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button Content="✎" Style="{StaticResource IconButtonStyle}"
                                                AutomationProperties.Name="Rename session"
                                                Width="22" Height="22" FontSize="{StaticResource GlyphSize}" Margin="2,0"
                                                Tag="{Binding}" Click="OnEditSessionTitleClicked"/>
                                        <Button Content="✕" Style="{StaticResource IconButtonStyle}"
                                                AutomationProperties.Name="Delete session"
                                                Width="22" Height="22" FontSize="{StaticResource GlyphSize}" Margin="2,0"
                                                Foreground="{StaticResource ErrorBrush}"
                                                Tag="{Binding}" Click="OnDeleteSessionClicked"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- ============ FEAT-9: Running ============ -->
                    <Grid Grid.Row="3" Margin="10,0,10,0"
                          Visibility="{Binding IsRunningTab, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Opacity="0.7" TextWrapping="Wrap" FontSize="{StaticResource FontSizeChrome}"
                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                       Text="Every Claude Code session on this machine."
                                       AutomationProperties.AutomationId="RunningSessionsBlurb"/>
                            <Button Content="Refresh" Style="{StaticResource ChipButtonStyle}"
                                    HorizontalAlignment="Right" Click="OnRefreshAgentSessionsClicked"
                                    AutomationProperties.AutomationId="RefreshAgentSessionsButton"/>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="Loading&#8230;" Opacity="0.6" VerticalAlignment="Top"
                                   FontSize="{StaticResource FontSizeChrome}"
                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                   Visibility="{Binding AgentSessions.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                   AutomationProperties.AutomationId="AgentSessionsLoading"/>

                        <TextBlock Grid.Row="1" Text="{Binding AgentSessions.LoadError}" TextWrapping="Wrap"
                                   VerticalAlignment="Top" FontSize="{StaticResource FontSizeChrome}"
                                   Foreground="{StaticResource ErrorBrush}"
                                   Visibility="{Binding AgentSessions.LoadError, Converter={StaticResource NullToVisibilityConverter}}"
                                   AutomationProperties.AutomationId="AgentSessionsError"/>

                        <TextBlock Grid.Row="1" VerticalAlignment="Top" TextWrapping="Wrap" Opacity="0.7"
                                   FontSize="{StaticResource FontSizeChrome}"
                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                   Text="No other Claude Code sessions are running on this machine."
                                   Visibility="{Binding AgentSessions.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                                   AutomationProperties.AutomationId="AgentSessionsEmptyState"/>

                        <ListBox Grid.Row="1" x:Name="AgentSessionsList"
                                 ItemsSource="{Binding AgentSessions.Sessions}"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource SessionListItemStyle}"
                                 AutomationProperties.AutomationId="AgentSessionsList">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AgentSessionEntry}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       FontSize="{StaticResource FontSizeBody}"/>
                                            <TextBlock Text="{Binding DetailLine}" Opacity="0.6"
                                                       FontSize="{StaticResource FontSizeChrome}"/>
                                            <TextBlock Text="{Binding Cwd}" Opacity="0.45" ToolTip="{Binding Cwd}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontFamily="Consolas" FontSize="{StaticResource FontSizeChrome}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrentFolder}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="Open here" Style="{StaticResource ChipButtonStyle}"
                                                Margin="6,0,0,0" VerticalAlignment="Center"
                                                Click="OnOpenAgentSessionHereClicked" Tag="{Binding}"
                                                IsEnabled="{Binding CanOpenHere}"
                                                ToolTip="{Binding OpenHereBlockedReason}"
                                                AutomationProperties.AutomationId="OpenAgentSessionHereButton"/>

                                        <Button Grid.Column="2" Content="Terminal" Style="{StaticResource ChipButtonStyle}"
                                                Margin="4,0,0,0" VerticalAlignment="Center"
                                                Click="OnOpenAgentSessionInTerminalClicked" Tag="{Binding}"
                                                IsEnabled="{Binding CanOpenInTerminal}"
                                                ToolTip="{Binding TerminalCommandText}"
                                                AutomationProperties.AutomationId="OpenAgentSessionTerminalButton"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- ============ FEAT-9: Cloud ============ -->
                    <StackPanel Grid.Row="3" Margin="10,0,10,0" VerticalAlignment="Top"
                                Visibility="{Binding IsCloudTab, Converter={StaticResource BoolToVisibilityConverter}}">

                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                                   FontSize="{StaticResource FontSizeChrome}"
                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                   Text="Open a cloud session by ID or link."
                                   AutomationProperties.AutomationId="CloudSessionBlurb"/>

                        <Border Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusControl}" Margin="0,0,0,6">
                            <Grid>
                                <TextBox x:Name="CloudSessionBox" BorderThickness="0" Background="Transparent"
                                         Padding="6,5" FontSize="{StaticResource FontSizeBody}" FontFamily="Consolas"
                                         Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                         CaretBrush="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                         Text="{Binding CloudSessionInput, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="CloudSessionBox"/>
                                <TextBlock IsHitTestVisible="False" Text="session_&#8230; &#183; cse_&#8230; &#183; claude.ai/code link"
                                           Opacity="0.4" Margin="6,5" VerticalAlignment="Center"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=CloudSessionBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding CloudHintText}" TextWrapping="Wrap" Opacity="0.6" Margin="0,0,0,8"
                                   FontSize="{StaticResource FontSizeChrome}"
                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                   AutomationProperties.AutomationId="CloudHintText"/>

                        <Button Content="Open in terminal" Style="{StaticResource ChipButtonStyle}"
                                HorizontalAlignment="Left" Click="OnOpenCloudSessionClicked"
                                IsEnabled="{Binding CanOpenCloudSession}"
                                AutomationProperties.AutomationId="OpenCloudSessionButton"/>

                        <!--
                            The gap, stated rather than papered over. Baseline lists an account's
                            cloud sessions by machine name; the CLI exposes no command that
                            enumerates them, so this tab takes an ID instead of pretending to a
                            list it cannot build.
                        -->
                        <Border Margin="0,14,0,0" Padding="8" CornerRadius="{StaticResource RadiusControl}"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Why there is no list" FontWeight="SemiBold" Margin="0,0,0,4"
                                           FontSize="{StaticResource FontSizeChrome}"
                                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="{StaticResource FontSizeChrome}"
                                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                           Text="The CLI has no command that lists your cloud sessions, and it refuses the streaming output format this panel reads &#8212; so a cloud session opens in a terminal, and is entered by ID."
                                           AutomationProperties.AutomationId="CloudGapNote"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== Raw output panel ===================== -->
        <Border Grid.Row="4" MaxHeight="160" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0"
                Visibility="{Binding IsRawOutputVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="6,3,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Raw CLI Output" FontSize="{StaticResource FontSizeChrome}" Opacity="0.55" VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                    <Button Grid.Column="1" Content="Copy All" Style="{StaticResource ChipButtonStyle}"
                            Click="OnCopyRawOutputClicked" Padding="7,2" FontSize="{StaticResource FontSizeChrome}"
                            AutomationProperties.AutomationId="CopyRawOutputButton"/>
                </Grid>
                <ScrollViewer Grid.Row="1" x:Name="RawOutputScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RawOutput}" Margin="6,2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="{StaticResource FontSizeChrome}" TextWrapping="NoWrap" Opacity="0.75"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===================== Input area ===================== -->
        <Border x:Name="InputAreaBorder" Grid.Row="5" Margin="10,6,10,10" Background="{StaticResource CardBackgroundBrush}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusCard}"
                AllowDrop="True" DragEnter="OnInputAreaDragEnter" DragLeave="OnInputAreaDragLeave"
                PreviewDragOver="OnInputAreaDragOver" Drop="OnInputAreaDrop"
                AutomationProperties.AutomationId="InputAreaBorder">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource ClaudeAccentBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid Margin="8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- FEAT-8: the dictation status line, collapsed unless the mic is live. -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <!--
                        FEAT-6. Baseline's own add menu, read out of its webview bundle: three
                        entries, in this order, with these labels and these tooltips (its "title"
                        attributes). Upload attaches files; Add context inserts "@" and lets the
                        mention picker take over; Browse the web is baseline's Chrome-tab
                        integration, which is not reproducible here - see WebContextComposer for
                        what it does instead and why.
                    -->
                    <Button x:Name="AddMenuButton" Click="OnAddMenuClicked"
                            Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,0" Padding="10,3"
                            ToolTip="Add"
                            AutomationProperties.AutomationId="AddMenuButton"
                            AutomationProperties.Name="Add">
                        <TextBlock Text="+" FontWeight="SemiBold"/>
                    </Button>
                    <Popup x:Name="AddMenuPopup" PlacementTarget="{Binding ElementName=AddMenuButton}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True"
                           AutomationProperties.AutomationId="AddMenuPopup">
                        <Border Style="{StaticResource PopupCardStyle}" MinWidth="280" MaxWidth="340"
                                Margin="0,0,0,4">
                            <StackPanel Margin="2,4">
                                <TextBlock Text="ADD" Style="{StaticResource MenuSectionHeaderStyle}"/>

                                <Button Style="{StaticResource MenuRowButtonStyle}" Click="OnUploadFromComputerClicked"
                                        ToolTip="Attach files from your computer"
                                        AutomationProperties.AutomationId="UploadFromComputerRow">
                                    <StackPanel>
                                        <TextBlock Text="Upload from computer"/>
                                        <TextBlock Text="Images, PDFs, and text files"
                                                   FontSize="{StaticResource FontSizeChrome}"
                                                   Opacity="0.6" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuRowButtonStyle}" Click="OnAddContextClicked"
                                        ToolTip="Add files or folders to the conversation"
                                        AutomationProperties.AutomationId="AddContextRow">
                                    <StackPanel>
                                        <TextBlock Text="Add context"/>
                                        <TextBlock Text="Mention a file from this solution with @"
                                                   FontSize="{StaticResource FontSizeChrome}"
                                                   Opacity="0.6" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuRowButtonStyle}" Click="OnBrowseTheWebClicked"
                                        ToolTip="Add web content to the conversation"
                                        AutomationProperties.AutomationId="BrowseTheWebRow">
                                    <StackPanel>
                                        <TextBlock Text="Browse the web"/>
                                        <TextBlock Text="Fetch a URL or search, via Claude's own web tools"
                                                   FontSize="{StaticResource FontSizeChrome}"
                                                   Opacity="0.6" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!--
                                    Revealed by the row above rather than shown outright: a text box
                                    sitting open in a three-item menu reads as the menu's subject
                                    instead of one entry's follow-up.
                                -->
                                <StackPanel x:Name="WebQueryPanel" Visibility="Collapsed" Margin="8,2,8,4"
                                            AutomationProperties.AutomationId="WebQueryPanel">
                                    <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusControl}" Padding="6,3">
                                        <TextBox x:Name="WebQueryBox" BorderThickness="0" Background="Transparent"
                                                 AcceptsReturn="False" MinHeight="20"
                                                 KeyDown="OnWebQueryKeyDown"
                                                 Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                                 CaretBrush="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                                 FontSize="{StaticResource FontSizeBody}"
                                                 AutomationProperties.AutomationId="WebQueryBox"/>
                                    </Border>
                                    <TextBlock Text="A URL is fetched; anything else is searched for."
                                               FontSize="{StaticResource FontSizeChrome}" Opacity="0.55"
                                               TextWrapping="Wrap" Margin="1,4,0,0"
                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                    <Button Content="Add" Click="OnAddWebContextClicked"
                                            Style="{StaticResource PrimaryButtonStyle}" Padding="12,4"
                                            HorizontalAlignment="Right" Margin="0,6,0,0"
                                            AutomationProperties.AutomationId="AddWebContextButton"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button Content="Active File" Click="OnAddActiveFileClicked"
                            Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,0"
                            ToolTip="Insert a reference to the active file"
                            AutomationProperties.AutomationId="ActiveFileChipButton"/>
                    <Button Content="Selection" Click="OnAddSelectionClicked"
                            Style="{StaticResource ChipButtonStyle}"
                            ToolTip="Insert a reference to the current selection"
                            AutomationProperties.AutomationId="SelectionChipButton"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding PendingImages}"
                                  Visibility="{Binding HasPendingImages, Converter={StaticResource BoolToVisibilityConverter}}"
                                  Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <!--
                                UX-9: a bare 44px square told the user nothing about what they had
                                staged. Baseline shows name + pixel dimensions, which is what makes
                                it obvious you pasted a 3840x2160 screenshot rather than the crop
                                you meant to.
                            -->
                            <DataTemplate DataType="{x:Type vm:PendingImageAttachment}">
                                <Border CornerRadius="{StaticResource RadiusControl}" Margin="0,0,6,6" Padding="3"
                                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Thumbnail}" Width="34" Height="34" Stretch="UniformToFill"/>
                                        <StackPanel VerticalAlignment="Center" Margin="6,0,4,0" MaxWidth="150">
                                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeChrome}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                            <TextBlock Text="{Binding DimensionsText}" FontSize="{StaticResource FontSizeChrome}"
                                                       Opacity="0.55"
                                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                        </StackPanel>
                                        <Button Content="✕" Click="OnRemovePendingImageClicked" Tag="{Binding}"
                                                AutomationProperties.Name="Remove image"
                                                Style="{StaticResource IconButtonStyle}" Width="16" Height="16" FontSize="{StaticResource GlyphSizeSmall}"
                                                VerticalAlignment="Top"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding PendingFiles}"
                                  Visibility="{Binding HasPendingFiles, Converter={StaticResource BoolToVisibilityConverter}}"
                                  Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PendingFileAttachment}">
                                <Border CornerRadius="{StaticResource RadiusControl}" Margin="0,0,6,0" Padding="6,3"
                                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- UX-9: PDF and text/code get different glyphs. -->
                                        <TextBlock Text="{Binding Icon}" Margin="0,0,5,0"
                                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSizeChrome}"
                                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                        <Button Content="✕" Click="OnRemovePendingFileClicked" Tag="{Binding}"
                                                AutomationProperties.Name="Remove file"
                                                Style="{StaticResource IconButtonStyle}" Width="16" Height="16" FontSize="{StaticResource GlyphSizeSmall}"
                                                Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Grid Grid.Row="2">
                    <TextBox x:Name="InputBox"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="28" MaxHeight="160"
                             VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                             CaretBrush="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                             Padding="2,2" FontSize="{StaticResource FontSizeBody}"
                             PreviewKeyDown="OnInputPreviewKeyDown"
                             TextChanged="OnInputTextChanged"
                             DataObject.Pasting="OnInputBoxPasting"
                             AutomationProperties.AutomationId="InputBox"/>

                    <!--
                        UX-6: the placeholder names the shortcut that focuses this box. Its text is
                        written at load time from the binding Visual Studio actually holds for the
                        tool-window command (see ApplyFocusShortcutHint), rather than hard-coded,
                        so it cannot advertise a chord the user has rebound or that failed to
                        register.
                    -->
                    <TextBlock x:Name="InputPlaceholder" IsHitTestVisible="False"
                               Margin="4,2,0,0" VerticalAlignment="Top" Opacity="0.45"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                               Text="Ask Claude anything…"
                               AutomationProperties.AutomationId="InputPlaceholder">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Popup x:Name="SlashCommandPopup" PlacementTarget="{Binding ElementName=InputBox}"
                       Placement="Top" StaysOpen="False" AllowsTransparency="True"
                       AutomationProperties.AutomationId="SlashCommandPopup">
                    <Border Background="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}"
                            TextElement.Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}"
                            MaxHeight="200" MinWidth="240">
                        <StackPanel>
                            <ListBox x:Name="SlashCommandList" BorderThickness="0" Background="Transparent"
                                     MaxHeight="160"
                                     Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                     ItemContainerStyle="{StaticResource PopupListItemStyle}"
                                     PreviewMouseLeftButtonUp="OnSlashCommandChosen"
                                     AutomationProperties.AutomationId="SlashCommandList"/>
                            <Border Style="{StaticResource PopupFooterStyle}">
                                <TextBlock Text="↑↓ to navigate · Enter to select · Esc to close"
                                           Style="{StaticResource KeyHintStyle}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>

                <Popup x:Name="FilePickerPopup" PlacementTarget="{Binding ElementName=InputBox}"
                       Placement="Top" StaysOpen="False" AllowsTransparency="True"
                       AutomationProperties.AutomationId="FilePickerPopup">
                    <Border Background="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}"
                            TextElement.Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}"
                            MaxHeight="240" MinWidth="300">
                        <StackPanel>
                        <ListBox x:Name="FilePickerList" BorderThickness="0" Background="Transparent"
                                 MaxHeight="200"
                                 Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                 ItemContainerStyle="{StaticResource PopupListItemStyle}"
                                 PreviewMouseLeftButtonUp="OnFilePickerChosen"
                                 AutomationProperties.AutomationId="FilePickerList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Converter={StaticResource FilePathToNameConverter}}"
                                                   FontFamily="Consolas" FontSize="{StaticResource FontSizeBody}" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Converter={StaticResource FilePathToDirConverter}}"
                                                   FontFamily="Consolas" FontSize="{StaticResource FontSizeChrome}" Opacity="0.5"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                            <Border Style="{StaticResource PopupFooterStyle}">
                                <TextBlock Text="↑↓ to navigate · Enter to select · Esc to close"
                                           Style="{StaticResource KeyHintStyle}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>

                <Grid Grid.Row="3" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">

                    <!-- Command palette: usage summary + Account & Usage + slash commands -->
                    <Button x:Name="PaletteButton" Style="{StaticResource ChipButtonStyle}"
                            Click="OnPaletteMenuClicked" Margin="0,0,4,0"
                            ToolTip="Usage, account &amp; commands"
                            AutomationProperties.AutomationId="PaletteButton"
                            AutomationProperties.Name="Usage, account and commands">
                        <TextBlock Text="/"/>
                    </Button>

                    <!-- Model -->
                    <Button x:Name="ModelButton" Style="{StaticResource ChipButtonStyle}"
                            Click="OnModelMenuClicked" Margin="0,0,4,0" ToolTip="Model"
                            AutomationProperties.AutomationId="ModelButton">
                        <TextBlock Text="{Binding SelectedModel.DisplayName}"/>
                    </Button>

                    <!-- Permission mode -->
                    <Button x:Name="PermissionButton" Style="{StaticResource ChipButtonStyle}"
                            Click="OnPermissionMenuClicked" Margin="0,0,4,0" ToolTip="Permission mode"
                            AutomationProperties.AutomationId="PermissionButton">
                        <TextBlock Text="{Binding SelectedPermissionMode.DisplayName}"/>
                    </Button>

                    <!-- Effort -->
                    <Button x:Name="EffortButton" Style="{StaticResource ChipButtonStyle}"
                            Click="OnEffortMenuClicked" ToolTip="Thinking effort"
                            AutomationProperties.AutomationId="EffortButton">
                        <TextBlock Text="{Binding SelectedThinkingLevel.DisplayName}"/>
                    </Button>

                    <!--
                        Context-window usage. Hidden below ContextIndicatorThresholdPercent
                        (Options > Claude Code > Context Indicator, default 50 - matches baseline).
                        Deliberately disabled while busy rather than reproducing baseline's own bug
                        (confirmed live, 2026-09-05: it sends "/compact" identically whether idle or
                        busy, which the CLI then delivers to the model as plain queued text once
                        dequeued mid-turn, producing a confused reply instead of actually compacting)
                        - see docs/Phase 23.
                    -->
                    <Button x:Name="ContextIndicatorButton" Style="{StaticResource ChipButtonStyle}"
                            Click="OnContextIndicatorClicked" Margin="4,0,0,0"
                            IsEnabled="{Binding CanCompact}"
                            ToolTip="{Binding ContextButtonTooltip}"
                            Visibility="{Binding IsContextIndicatorVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.AutomationId="ContextIndicatorButton"
                            AutomationProperties.Name="Context window usage, click to compact">
                        <TextBlock Text="{Binding ContextIndicatorText}"
                                   Foreground="{Binding ContextPercentUsed, Converter={StaticResource ContextPercentToBrushConverter}}"/>
                    </Button>

                    </StackPanel>

                    <Popup x:Name="PalettePopup" PlacementTarget="{Binding ElementName=PaletteButton}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True"
                           AutomationProperties.AutomationId="PalettePopup">
                        <Border Style="{StaticResource PopupCardStyle}"
                                MinWidth="260" MaxWidth="340" MaxHeight="420">
                            <DockPanel>
                                <!--
                                    UX-10: the version a bug report should quote. Read from the
                                    shipped VSIX manifest, not the assembly - see ExtensionVersion.
                                -->
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource PopupFooterStyle}">
                                    <TextBlock Text="{Binding ExtensionVersionText}"
                                               Style="{StaticResource KeyHintStyle}"
                                               AutomationProperties.AutomationId="PaletteVersionText"/>
                                </Border>

                                <!--
                                    UX-4: filter box. The palette lists every slash command the CLI
                                    reports - around fifty - and without a filter the only way to
                                    reach one was to scroll and read. Filters the shared
                                    SlashCommands view, so the list and its A-Z order stay one
                                    source of truth (UX-5).
                                -->
                                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource HairlineBrush}"
                                        BorderThickness="0,0,0,1" Padding="8,6" Margin="0,0,0,2">
                                    <Grid>
                                        <TextBox x:Name="PaletteFilterBox" BorderThickness="0" Background="Transparent"
                                                 Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                                 CaretBrush="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                                 FontSize="{StaticResource FontSizeBody}"
                                                 TextChanged="OnPaletteFilterChanged"
                                                 AutomationProperties.AutomationId="PaletteFilterBox"/>
                                        <TextBlock Text="Filter actions…" IsHitTestVisible="False" Opacity="0.45"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=PaletteFilterBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="THIS SESSION" Style="{StaticResource MenuSectionHeaderStyle}"/>
                                    <TextBlock Text="{Binding SessionUsageText}" FontSize="{StaticResource FontSizeChrome}" Opacity="0.75"
                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                               Margin="8,0,8,4" TextWrapping="Wrap"/>
                                    <Button Content="Account &amp; Usage →" Style="{StaticResource MenuRowButtonStyle}"
                                            Click="OnAccountUsageClicked" FontSize="{StaticResource FontSizeChrome}"
                                            Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                            Margin="0,0,0,2"/>

                                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="6,6"/>

                                    <!--
                                        FEAT-1. Baseline registers this as a command in its own
                                        "Context" category, with this label and this description -
                                        so it gets a section here rather than being folded into
                                        Customize, which is hand-offs and panels.
                                    -->
                                    <TextBlock Text="CONTEXT" Style="{StaticResource MenuSectionHeaderStyle}"/>
                                    <Button Style="{StaticResource MenuRowButtonStyle}" Click="OnRewindClicked"
                                            AutomationProperties.AutomationId="RewindRow">
                                        <StackPanel>
                                            <TextBlock Text="Rewind"/>
                                            <TextBlock Text="Restore code and conversation to an earlier point"
                                                       FontSize="{StaticResource FontSizeChrome}"
                                                       Opacity="0.6" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="6,6"/>

                                    <!--
                                        GAP-1 / GAP-2. Baseline groups these under "Customize" and
                                        so do we, with its labels and menu descriptions verbatim -
                                        see TerminalHandoffCatalog for where each string came from.
                                        Five of the six are hand-offs; "Open Claude in Terminal" is
                                        the plain launcher they all build on.
                                    -->
                                    <TextBlock Text="CUSTOMIZE" Style="{StaticResource MenuSectionHeaderStyle}"/>
                                    <ItemsControl ItemsSource="{Binding TerminalHandoffs}"
                                                  ItemTemplate="{StaticResource TerminalHandoffMenuItemTemplate}"/>
                                    <!--
                                        FEAT-4 / FEAT-5. The two Customize entries that are real GUI
                                        panels rather than terminal hand-offs. Baseline's labels.
                                    -->
                                    <Button Style="{StaticResource MenuRowButtonStyle}" Click="OnMcpServersClicked"
                                            AutomationProperties.AutomationId="McpServersRow">
                                        <StackPanel>
                                            <TextBlock Text="MCP servers"/>
                                            <TextBlock Text="Connect external tools and data"
                                                       FontSize="{StaticResource FontSizeChrome}"
                                                       Opacity="0.6" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource MenuRowButtonStyle}" Click="OnManagePluginsClicked"
                                            AutomationProperties.AutomationId="ManagePluginsRow">
                                        <StackPanel>
                                            <TextBlock Text="Manage plugins"/>
                                            <TextBlock Text="Install plugins from marketplaces"
                                                       FontSize="{StaticResource FontSizeChrome}"
                                                       Opacity="0.6" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource MenuRowButtonStyle}" Click="OnOpenInTerminalClicked"
                                            AutomationProperties.AutomationId="OpenInTerminalRow">
                                        <StackPanel>
                                            <TextBlock Text="Open Claude in Terminal"/>
                                            <TextBlock Text="Start an interactive CLI session here"
                                                       FontSize="{StaticResource FontSizeChrome}"
                                                       Opacity="0.6" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="6,6"/>

                                    <TextBlock Text="COMMANDS" Style="{StaticResource MenuSectionHeaderStyle}"/>
                                    <ItemsControl ItemsSource="{Binding SlashCommands}" ItemTemplate="{StaticResource SlashCommandMenuItemTemplate}"/>
                                </StackPanel>
                            </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>

                    <Popup x:Name="ModelPopup" PlacementTarget="{Binding ElementName=ModelButton}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True"
                           AutomationProperties.AutomationId="ModelPopup">
                        <Border Style="{StaticResource PopupCardStyle}" MinWidth="300" MaxWidth="360">
                            <StackPanel Margin="2,4">
                                <TextBlock Text="MODELS" Style="{StaticResource MenuSectionHeaderStyle}"/>
                                <ItemsControl ItemsSource="{Binding Models}" ItemTemplate="{StaticResource ModelMenuItemTemplate}"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Popup x:Name="PermissionPopup" PlacementTarget="{Binding ElementName=PermissionButton}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True"
                           AutomationProperties.AutomationId="PermissionPopup">
                        <Border Style="{StaticResource PopupCardStyle}" MinWidth="320" MaxWidth="380">
                            <StackPanel Margin="2,4">
                                <Grid>
                                    <TextBlock Text="MODES" Style="{StaticResource MenuSectionHeaderStyle}"/>
                                    <!-- UX-2: baseline's own hint wording, for a chord we really do handle. -->
                                    <TextBlock Text="⇧ + tab to switch" Style="{StaticResource KeyHintStyle}"
                                               HorizontalAlignment="Right" Margin="0,8,10,2"
                                               AutomationProperties.AutomationId="PermissionCycleHint"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding PermissionModes}" ItemTemplate="{StaticResource PermissionMenuItemTemplate}"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Popup x:Name="EffortPopup" PlacementTarget="{Binding ElementName=EffortButton}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True"
                           AutomationProperties.AutomationId="EffortPopup">
                        <Border Style="{StaticResource PopupCardStyle}" MinWidth="200">
                            <StackPanel Margin="2,4">
                                <TextBlock Text="THINKING EFFORT" Style="{StaticResource MenuSectionHeaderStyle}"/>
                                <ItemsControl ItemsSource="{Binding ThinkingLevels}" ItemTemplate="{StaticResource ThinkingMenuItemTemplate}"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Popup x:Name="AccountUsagePopup" PlacementTarget="{Binding ElementName=PaletteButton}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True"
                           AutomationProperties.AutomationId="AccountUsagePopup">
                        <Border Style="{StaticResource PopupCardStyle}" MinWidth="340" MaxWidth="420">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
                                <StackPanel Margin="14,10">

                                    <!-- Title row -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Account &amp; Usage" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                        <Button Grid.Column="1" Content="✕" Style="{StaticResource IconButtonStyle}"
                                                Click="OnCloseAccountUsageClicked" Width="20" Height="20" FontSize="{StaticResource GlyphSize}"
                                                AutomationProperties.AutomationId="CloseAccountUsageButton"
                                                AutomationProperties.Name="Close account &amp; usage"/>
                                    </Grid>

                                    <!-- Loading -->
                                    <TextBlock Text="Loading…" FontSize="{StaticResource FontSizeChrome}" Opacity="0.6"
                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                               Margin="0,0,0,8"
                                               Visibility="{Binding AccountUsage.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- Error -->
                                    <TextBlock Text="{Binding AccountUsage.LoadError}" FontSize="{StaticResource FontSizeChrome}" TextWrapping="Wrap"
                                               Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,8"
                                               Visibility="{Binding AccountUsage.LoadError, Converter={StaticResource NullToVisibilityConverter}}"/>

                                    <!-- Content (hidden while loading) -->
                                    <StackPanel Visibility="{Binding AccountUsage.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">

                                        <!-- ── ACCOUNT ─────────────────────────────── -->
                                        <TextBlock Text="ACCOUNT" Style="{StaticResource MenuSectionHeaderStyle}" Margin="0,0,0,6"/>

                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Auth method" Opacity="0.65" FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AccountUsage.AuthMethod}" FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                        </Grid>

                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Email" Opacity="0.65" FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AccountUsage.Email}" FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                        </Grid>

                                        <Grid Margin="0,2,0,2"
                                              Visibility="{Binding AccountUsage.Organization, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Organization" Opacity="0.65" FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AccountUsage.Organization}" FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                                       MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                        </Grid>

                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Plan" Opacity="0.65" FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AccountUsage.Plan}" FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,0,0,8"/>

                                        <!-- ── USAGE ──────────────────────────────── -->
                                        <TextBlock Text="USAGE" Style="{StaticResource MenuSectionHeaderStyle}" Margin="0,0,0,8"/>

                                        <!-- Session bar -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding AccountUsage.SessionLabel}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AccountUsage.SessionPercentLabel}" FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding AccountUsage.SessionPercent, Mode=OneWay}"
                                                     Style="{StaticResource UsageBarStyle}" Margin="0,0,0,4"
                                                     Visibility="{Binding AccountUsage.HasRateLimitData, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <Border Height="6" CornerRadius="{StaticResource RadiusControl}" Background="{StaticResource HairlineBrush}" Margin="0,0,0,4"
                                                Visibility="{Binding AccountUsage.HasRateLimitData, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <TextBlock Text="{Binding AccountUsage.SessionResetLabel}" FontSize="{StaticResource FontSizeChrome}" Opacity="0.6"
                                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                                   Margin="0,0,0,10"/>

                                        <!-- Weekly bar -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding AccountUsage.WeeklyLabel}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AccountUsage.WeeklyPercentLabel}" FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding AccountUsage.WeeklyPercent, Mode=OneWay}"
                                                     Style="{StaticResource UsageBarStyle}" Margin="0,0,0,4"
                                                     Visibility="{Binding AccountUsage.HasRateLimitData, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <Border Height="6" CornerRadius="{StaticResource RadiusControl}" Background="{StaticResource HairlineBrush}" Margin="0,0,0,4"
                                                Visibility="{Binding AccountUsage.HasRateLimitData, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <TextBlock Text="{Binding AccountUsage.WeeklyResetLabel}" FontSize="{StaticResource FontSizeChrome}" Opacity="0.6"
                                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                                   Margin="0,0,0,6"/>

                                        <TextBlock FontSize="{StaticResource FontSizeChrome}" Margin="0,0,0,10">
                                            <Hyperlink RequestNavigate="OnManageUsageClicked"
                                                       NavigateUri="https://claude.ai/settings/limits"
                                                       Foreground="{StaticResource ClaudeAccentBrush}">
                                                Manage usage on claude.ai
                                            </Hyperlink>
                                        </TextBlock>

                                        <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,0,0,8"/>

                                        <!-- ── THIS SESSION ───────────────────────── -->
                                        <TextBlock Text="THIS SESSION" Style="{StaticResource MenuSectionHeaderStyle}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SessionUsageText}" FontSize="{StaticResource FontSizeChrome}" Opacity="0.75"
                                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                                   Margin="0,0,0,10" TextWrapping="Wrap"/>

                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>

                    <!--
                        ===================== FEAT-4: MCP servers =====================

                        One of only two entries in baseline's "Customize" section that open a real
                        GUI panel instead of handing off to a terminal. Everything shown here comes
                        from `claude mcp list` - including the empty state, which is the CLI's own
                        sentence rather than a copy of it (see McpServersViewModel).
                    -->
                    <Popup x:Name="McpPopup" PlacementTarget="{Binding ElementName=PaletteButton}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True"
                           AutomationProperties.AutomationId="McpPopup">
                        <Border Style="{StaticResource PopupCardStyle}" MinWidth="340" MaxWidth="440">
                            <DockPanel>

                                <Grid DockPanel.Dock="Top" Margin="14,10,10,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="MCP servers" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                                   AutomationProperties.AutomationId="McpPanelTitle"/>
                                        <!-- Project-scoped servers depend on which directory the query ran in. -->
                                        <TextBlock Text="{Binding McpServers.ScopeDirectory}" Style="{StaticResource KeyHintStyle}"
                                                   Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding McpServers.ScopeDirectory}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="✕" Style="{StaticResource IconButtonStyle}"
                                            Click="OnCloseMcpClicked" Width="20" Height="20" FontSize="{StaticResource GlyphSize}"
                                            AutomationProperties.Name="Close MCP servers"
                                            VerticalAlignment="Top"
                                            AutomationProperties.AutomationId="CloseMcpButton"/>
                                </Grid>

                                <Border DockPanel.Dock="Bottom" Style="{StaticResource PopupFooterStyle}">
                                    <TextBlock Style="{StaticResource KeyHintStyle}">
                                        <Hyperlink NavigateUri="https://code.claude.com/docs/en/mcp"
                                                   RequestNavigate="OnDocsLinkClicked"
                                                   Foreground="{StaticResource ClaudeAccentBrush}"
                                                   AutomationProperties.AutomationId="McpLearnMoreLink">Learn more about MCP</Hyperlink>
                                    </TextBlock>
                                </Border>

                                <Grid Margin="14,4,14,4" MinHeight="60">
                                    <TextBlock Text="Loading…" FontSize="{StaticResource FontSizeChrome}" Opacity="0.6"
                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                               Visibility="{Binding McpServers.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                               AutomationProperties.AutomationId="McpLoadingText"/>

                                    <StackPanel Visibility="{Binding McpServers.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                        <TextBlock Text="{Binding McpServers.LoadError}" FontSize="{StaticResource FontSizeChrome}"
                                                   TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,6"
                                                   Visibility="{Binding McpServers.LoadError, Converter={StaticResource NullToVisibilityConverter}}"
                                                   AutomationProperties.AutomationId="McpErrorText"/>

                                        <!-- The CLI's own "nothing configured" sentence. -->
                                        <TextBlock Text="{Binding McpServers.EmptyStateText}" FontSize="{StaticResource FontSizeBody}"
                                                   TextWrapping="Wrap" Opacity="0.7" TextAlignment="Center" Margin="6,12,6,12"
                                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                                   Visibility="{Binding McpServers.Servers.Count, Converter={StaticResource CountToVisibilityConverter}}"
                                                   AutomationProperties.AutomationId="McpEmptyStateText"/>

                                        <ItemsControl ItemsSource="{Binding McpServers.Servers}"
                                                      AutomationProperties.AutomationId="McpServerList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="7" Height="7" Margin="0,5,7,0" VerticalAlignment="Top"
                                                                 Fill="{Binding Kind, Converter={StaticResource McpStatusToBrushConverter}}"/>
                                                        <StackPanel Grid.Column="1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                           FontSize="{StaticResource FontSizeBody}"
                                                                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                                                <TextBlock Text="{Binding Transport}" Style="{StaticResource KeyHintStyle}"
                                                                           Margin="6,1,0,0"
                                                                           Visibility="{Binding HasTransport, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Target}" FontSize="{StaticResource FontSizeChrome}"
                                                                       Opacity="0.6" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Target}"
                                                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                                            <TextBlock Text="{Binding Status}" FontSize="{StaticResource FontSizeChrome}"
                                                                       Margin="0,1,0,0" TextWrapping="Wrap"
                                                                       Foreground="{Binding Kind, Converter={StaticResource McpStatusToBrushConverter}}"/>
                                                            <TextBlock Text="{Binding Issue}" FontSize="{StaticResource FontSizeChrome}"
                                                                       Opacity="0.7" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                                                       Visibility="{Binding HasIssue, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Popup>

                    <!--
                        ===================== FEAT-5: Manage plugins =====================

                        Baseline's other real GUI panel, and the reason TerminalHandoffCatalog skips
                        the `plugins` hand-off entirely. The Plugins / Marketplaces tab strip is
                        baseline's; the contents come from `claude plugin list` (asked for JSON, with available
                        plugins included) and `claude plugin marketplace list`.
                    -->
                    <Popup x:Name="PluginsPopup" PlacementTarget="{Binding ElementName=PaletteButton}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True"
                           AutomationProperties.AutomationId="PluginsPopup">
                        <Border Style="{StaticResource PopupCardStyle}" MinWidth="340" MaxWidth="440">
                            <DockPanel>

                                <Grid DockPanel.Dock="Top" Margin="14,10,10,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Manage plugins" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                               AutomationProperties.AutomationId="PluginsPanelTitle"/>
                                    <Button Grid.Column="1" Content="✕" Style="{StaticResource IconButtonStyle}"
                                            Click="OnClosePluginsClicked" Width="20" Height="20" FontSize="{StaticResource GlyphSize}"
                                            AutomationProperties.AutomationId="ClosePluginsButton"
                                            AutomationProperties.Name="Close plugins"/>
                                </Grid>

                                <!-- Tab strip. The underline, not a fill, marks the active tab. -->
                                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource HairlineBrush}"
                                        BorderThickness="0,0,0,1" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                        <Grid Margin="0,0,4,0">
                                            <Button Style="{StaticResource ChipButtonStyle}" Click="OnPluginsTabClicked"
                                                    BorderThickness="0" Background="Transparent"
                                                    AutomationProperties.AutomationId="PluginsTabButton">
                                                <TextBlock Text="Plugins"/>
                                            </Button>
                                            <Border Height="2" VerticalAlignment="Bottom" Background="{StaticResource ClaudeAccentBrush}"
                                                    Visibility="{Binding Plugins.IsPluginsTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>
                                        <Grid>
                                            <Button Style="{StaticResource ChipButtonStyle}" Click="OnMarketplacesTabClicked"
                                                    BorderThickness="0" Background="Transparent"
                                                    AutomationProperties.AutomationId="MarketplacesTabButton">
                                                <TextBlock Text="Marketplaces"/>
                                            </Button>
                                            <Border Height="2" VerticalAlignment="Bottom" Background="{StaticResource ClaudeAccentBrush}"
                                                    Visibility="{Binding Plugins.IsMarketplacesTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border DockPanel.Dock="Bottom" Style="{StaticResource PopupFooterStyle}">
                                    <TextBlock Style="{StaticResource KeyHintStyle}">
                                        <Hyperlink NavigateUri="https://code.claude.com/docs/en/plugins"
                                                   RequestNavigate="OnDocsLinkClicked"
                                                   Foreground="{StaticResource ClaudeAccentBrush}"
                                                   AutomationProperties.AutomationId="PluginsLearnMoreLink">Learn more about plugins</Hyperlink>
                                    </TextBlock>
                                </Border>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360">
                                    <Grid Margin="14,4,14,4" MinHeight="60">
                                        <TextBlock Text="Loading…" FontSize="{StaticResource FontSizeChrome}" Opacity="0.6"
                                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                                   Visibility="{Binding Plugins.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   AutomationProperties.AutomationId="PluginsLoadingText"/>

                                        <StackPanel Visibility="{Binding Plugins.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                            <TextBlock Text="{Binding Plugins.LoadError}" FontSize="{StaticResource FontSizeChrome}"
                                                       TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,6"
                                                       Visibility="{Binding Plugins.LoadError, Converter={StaticResource NullToVisibilityConverter}}"
                                                       AutomationProperties.AutomationId="PluginsErrorText"/>

                                            <!-- Plugins tab -->
                                            <StackPanel Visibility="{Binding Plugins.IsPluginsTab, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Plugins.PluginsEmptyStateText}" FontSize="{StaticResource FontSizeBody}"
                                                           TextWrapping="Wrap" Opacity="0.7" TextAlignment="Center" Margin="6,12,6,12"
                                                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                                           Visibility="{Binding Plugins.IsPluginListEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                                                           AutomationProperties.AutomationId="PluginsEmptyStateText"/>

                                                <TextBlock Text="INSTALLED" Style="{StaticResource MenuSectionHeaderStyle}" Margin="0,2,0,2"
                                                           Visibility="{Binding Plugins.InstalledPlugins.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                <ItemsControl ItemsSource="{Binding Plugins.InstalledPlugins}"
                                                              ItemTemplate="{StaticResource PluginRowTemplate}"
                                                              AutomationProperties.AutomationId="InstalledPluginList"/>

                                                <TextBlock Text="AVAILABLE" Style="{StaticResource MenuSectionHeaderStyle}" Margin="0,8,0,2"
                                                           Visibility="{Binding Plugins.AvailablePlugins.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                <ItemsControl ItemsSource="{Binding Plugins.AvailablePlugins}"
                                                              ItemTemplate="{StaticResource PluginRowTemplate}"
                                                              AutomationProperties.AutomationId="AvailablePluginList"/>
                                            </StackPanel>

                                            <!-- Marketplaces tab -->
                                            <StackPanel Visibility="{Binding Plugins.IsMarketplacesTab, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Plugins.MarketplacesEmptyStateText}" FontSize="{StaticResource FontSizeBody}"
                                                           TextWrapping="Wrap" Opacity="0.7" TextAlignment="Center" Margin="6,12,6,12"
                                                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                                           Visibility="{Binding Plugins.Marketplaces.Count, Converter={StaticResource CountToVisibilityConverter}}"
                                                           AutomationProperties.AutomationId="MarketplacesEmptyStateText"/>

                                                <ItemsControl ItemsSource="{Binding Plugins.Marketplaces}"
                                                              AutomationProperties.AutomationId="MarketplaceList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,4,0,4">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                           FontSize="{StaticResource FontSizeBody}"
                                                                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                                                <TextBlock Text="{Binding DetailLine}" FontSize="{StaticResource FontSizeChrome}"
                                                                           Opacity="0.6" TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Path}"
                                                                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>

                    <!--
                        ================== FEAT-1: rewind and fork ==================

                        Three surfaces, because baseline has three: the picker ("Rewind to…"), the
                        per-message `…` menu, and the confirmation the two file-touching actions
                        both pass through. All the copy here is baseline's own, read out of its
                        webview bundle (v2.1.251) rather than paraphrased - including the empty
                        state, the key hints, the fork note, and the warning about manual edits,
                        which is a real limitation of the CLI's checkpoints and not decoration.

                        The one deliberate difference: baseline's picker always does "restore code
                        AND fork", keeping the three-way choice for the per-message menu. The
                        backlog asked for the two to be independently selectable from BOTH
                        surfaces, so a row here is selected first and the same three actions follow.
                    -->
                    <Popup x:Name="RewindPopup" PlacementTarget="{Binding ElementName=PaletteButton}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True"
                           IsOpen="{Binding IsRewindPickerVisible, Mode=TwoWay}"
                           AutomationProperties.AutomationId="RewindPopup">
                        <Border Style="{StaticResource PopupCardStyle}" MinWidth="380" MaxWidth="520">
                            <DockPanel>

                                <Grid DockPanel.Dock="Top" Margin="14,10,10,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Rewind to…" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                               AutomationProperties.AutomationId="RewindPanelTitle"/>
                                    <Button Grid.Column="1" Content="✕" Style="{StaticResource IconButtonStyle}"
                                            Click="OnCloseRewindClicked" Width="20" Height="20"
                                            AutomationProperties.Name="Close rewind panel"
                                            FontSize="{StaticResource GlyphSize}" VerticalAlignment="Top"
                                            AutomationProperties.AutomationId="CloseRewindButton"/>
                                </Grid>

                                <Border DockPanel.Dock="Bottom" Style="{StaticResource PopupFooterStyle}">
                                    <TextBlock Style="{StaticResource KeyHintStyle}"
                                               Text="↑ ↓ to navigate · Enter to select · Esc to close"/>
                                </Border>

                                <!-- The three actions, enabled once a row is picked. -->
                                <StackPanel DockPanel.Dock="Bottom" Margin="10,2,10,6"
                                            Visibility="{Binding RewindPoints.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}">
                                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,2,0,4"/>
                                    <Button Style="{StaticResource MenuRowButtonStyle}" Click="OnRewindForkClicked"
                                            IsEnabled="{Binding HasSelectedRewindPoint}"
                                            Content="Fork conversation from here"
                                            AutomationProperties.AutomationId="RewindForkRow"/>
                                    <Button Style="{StaticResource MenuRowButtonStyle}" Click="OnRewindCodeClicked"
                                            IsEnabled="{Binding HasSelectedRewindPoint}"
                                            Content="Rewind code to here"
                                            AutomationProperties.AutomationId="RewindCodeRow"/>
                                    <Button Style="{StaticResource MenuRowButtonStyle}" Click="OnRewindForkAndCodeClicked"
                                            IsEnabled="{Binding HasSelectedRewindPoint}"
                                            Content="Fork conversation and rewind code"
                                            AutomationProperties.AutomationId="RewindForkAndCodeRow"/>
                                </StackPanel>

                                <Grid Margin="14,0,14,4" MinHeight="60" MaxHeight="260">
                                    <TextBlock Text="{Binding RewindEmptyStateText}" FontSize="{StaticResource FontSizeBody}"
                                               TextWrapping="Wrap" Opacity="0.7" TextAlignment="Center" Margin="6,12,6,12"
                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                               Visibility="{Binding RewindPoints.Count, Converter={StaticResource CountToVisibilityConverter}}"
                                               AutomationProperties.AutomationId="RewindEmptyStateText"/>

                                    <DockPanel Visibility="{Binding RewindPoints.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}">
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource KeyHintStyle}"
                                                   TextWrapping="Wrap" Margin="0,0,0,4"
                                                   Text="Select a message to restore code and fork the conversation from that point."/>
                                        <ListBox x:Name="RewindList" BorderThickness="0" Background="Transparent"
                                                 ItemsSource="{Binding RewindPoints}"
                                                 SelectedItem="{Binding SelectedRewindPoint, Mode=TwoWay}"
                                                 ItemContainerStyle="{StaticResource SessionListItemStyle}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 AutomationProperties.AutomationId="RewindList">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:RewindPoint}">
                                                    <Grid Margin="0,2,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding PromptText}" TextTrimming="CharacterEllipsis"
                                                                   FontSize="{StaticResource FontSizeBody}" MaxHeight="34"
                                                                   TextWrapping="Wrap" ToolTip="{Binding PromptText}"
                                                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding RelativeTime}"
                                                                   Style="{StaticResource KeyHintStyle}" Margin="8,1,0,0"
                                                                   VerticalAlignment="Top"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Popup>

                    <!--
                        The per-message menu. PlacementTarget is assigned in code-behind because the
                        anchor is whichever `…` was clicked, and the popup is shared rather than one
                        per message.
                    -->
                    <Popup x:Name="MessageActionsPopup" Placement="Bottom" StaysOpen="False"
                           AllowsTransparency="True" AutomationProperties.AutomationId="MessageActionsPopup">
                        <Border Style="{StaticResource PopupCardStyle}" MinWidth="240">
                            <StackPanel Margin="2,4">
                                <TextBlock Text="REWIND" Style="{StaticResource MenuSectionHeaderStyle}"/>
                                <Button Style="{StaticResource MenuRowButtonStyle}" Click="OnMessageForkClicked"
                                        Content="Fork conversation from here"
                                        AutomationProperties.AutomationId="MessageForkRow"/>
                                <Button Style="{StaticResource MenuRowButtonStyle}" Click="OnMessageRewindCodeClicked"
                                        Content="Rewind code to here"
                                        AutomationProperties.AutomationId="MessageRewindCodeRow"/>
                                <Button Style="{StaticResource MenuRowButtonStyle}" Click="OnMessageForkAndRewindClicked"
                                        Content="Fork conversation and rewind code"
                                        AutomationProperties.AutomationId="MessageForkAndRewindRow"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!--
                        The confirmation. StaysOpen because this one writes to the user's working
                        tree: it closes on its own two buttons and on nothing else, so a stray click
                        cannot dismiss the thing that was about to explain what is going to change.
                    -->
                    <Popup x:Name="RewindConfirmPopup" PlacementTarget="{Binding ElementName=PaletteButton}"
                           Placement="Top" StaysOpen="True" AllowsTransparency="True"
                           IsOpen="{Binding IsRewindConfirmVisible, Mode=TwoWay}"
                           AutomationProperties.AutomationId="RewindConfirmPopup">
                        <Border Style="{StaticResource PopupCardStyle}" MinWidth="380" MaxWidth="520">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding RewindConfirmTitle}"
                                           FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"
                                           Margin="14,10,14,4"
                                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                           AutomationProperties.AutomationId="RewindConfirmTitle"/>

                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                            HorizontalAlignment="Right" Margin="14,4,14,10">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="{Binding RewindConfirmButtonText}"
                                            IsEnabled="{Binding CanConfirmRewind}"
                                            Click="OnConfirmRewindClicked" Margin="0,0,6,0"
                                            AutomationProperties.AutomationId="ConfirmRewindButton"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Never mind"
                                            Click="OnCancelRewindClicked"
                                            AutomationProperties.AutomationId="CancelRewindButton"/>
                                </StackPanel>

                                <StackPanel Margin="14,0,14,4">
                                    <TextBlock Text="{Binding RewindTargetPreview}" FontSize="{StaticResource FontSizeChrome}"
                                               Opacity="0.7" TextWrapping="Wrap" MaxHeight="46" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6"
                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                               AutomationProperties.AutomationId="RewindTargetPreview"/>

                                    <TextBlock Text="A new forked conversation will be created after rewinding."
                                               FontSize="{StaticResource FontSizeChrome}" TextWrapping="Wrap"
                                               Margin="0,0,0,6" Opacity="0.8"
                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                               Visibility="{Binding ShowRewindForkNote, Converter={StaticResource BoolToVisibilityConverter}}"
                                               AutomationProperties.AutomationId="RewindForkNote"/>

                                    <TextBlock Text="Checking what would change…" FontSize="{StaticResource FontSizeChrome}"
                                               Opacity="0.6"
                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                               Visibility="{Binding IsRewindPreviewLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                               AutomationProperties.AutomationId="RewindPreviewLoadingText"/>

                                    <TextBlock Text="{Binding RewindPreviewError}" FontSize="{StaticResource FontSizeChrome}"
                                               TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,4"
                                               Visibility="{Binding RewindPreviewError, Converter={StaticResource NullToVisibilityConverter}}"
                                               AutomationProperties.AutomationId="RewindPreviewError"/>

                                    <StackPanel Visibility="{Binding RewindHasChanges, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding RewindChangeSummary}" FontSize="{StaticResource FontSizeChrome}"
                                                   FontWeight="SemiBold" Margin="0,0,0,2"
                                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                                   AutomationProperties.AutomationId="RewindChangeSummary"/>
                                        <ItemsControl ItemsSource="{Binding RewindFilesChanged}" MaxHeight="140"
                                                      AutomationProperties.AutomationId="RewindFileList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="{StaticResource FontSizeChrome}"
                                                               Opacity="0.75" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding}" Margin="0,1,0,1"
                                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <TextBlock FontSize="{StaticResource FontSizeChrome}" TextWrapping="Wrap" Opacity="0.75"
                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                               Text="The code has not changed, so no code will be restored."
                                               AutomationProperties.AutomationId="RewindNoChangesText">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RewindHasChanges}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRewindPreviewLoading}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- A real limitation of the CLI's checkpoints, in its own words. -->
                                    <TextBlock Text="⚠ Rewinding does not affect files edited manually or via bash."
                                               FontSize="{StaticResource FontSizeChrome}" TextWrapping="Wrap"
                                               Opacity="0.7" Margin="0,6,0,0"
                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                               AutomationProperties.AutomationId="RewindManualEditWarning"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Popup>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">

                        <!--
                            FEAT-8. Baseline's tooltip verbatim - "Tap or hold to record · Ctrl+D" -
                            but only when dictation can actually work; when it cannot, the tooltip is
                            the reason instead, because a greyed-out mic that explains nothing is the
                            thing worth avoiding. Both strings come from the view model, which owns
                            the availability probe (see VoiceInput.Probe).

                            Tap and hold are one control: a quick click toggles, and holding the
                            button records only while it is held. The code-behind tells them apart
                            by how long the press lasted - see OnMicButtonUp.
                        -->
                        <Button x:Name="MicButton" Style="{StaticResource ChipButtonStyle}"
                                Margin="0,0,4,0" VerticalAlignment="Center"
                                IsEnabled="{Binding IsVoiceAvailable}"
                                ToolTip="{Binding VoiceTooltipText}"
                                PreviewMouseLeftButtonDown="OnMicButtonDown"
                                PreviewMouseLeftButtonUp="OnMicButtonUp"
                                Click="OnMicClicked"
                                AutomationProperties.AutomationId="MicButton"
                                AutomationProperties.Name="Dictate">
                            <TextBlock x:Name="MicGlyph" Text="🎤" FontSize="{StaticResource GlyphSize}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDictating}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                <Setter Property="Text" Value="⏺"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <Grid>
                            <Button x:Name="SendButton" Style="{StaticResource AccentButtonStyle}"
                                    Click="OnSendClicked" Margin="6,0,0,0" ToolTip="Send (Enter)"
                                    AutomationProperties.AutomationId="SendButton"
                                    AutomationProperties.Name="Send">
                                <TextBlock Text="➤" FontSize="{StaticResource GlyphSize}"/>
                            </Button>
                            <Button x:Name="StopButton" Style="{StaticResource StopButtonStyle}"
                                    Click="OnStopClicked" Margin="6,0,0,0" Visibility="Collapsed" ToolTip="Stop"
                                    AutomationProperties.AutomationId="StopButton"
                                    AutomationProperties.Name="Stop">
                                <TextBlock Text="■" FontSize="{StaticResource GlyphSize}"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!--
                    FEAT-8. What the recognizer currently thinks it heard, so the mic is visibly
                    live rather than just red. Committed text goes into the composer; this line is
                    the in-flight guess and is discarded when the phrase resolves.
                -->
                <TextBlock Grid.Row="4" Text="{Binding VoiceStatusText}" Margin="2,4,0,0"
                           FontSize="{StaticResource FontSizeChrome}" Opacity="0.7"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="60"
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                           Visibility="{Binding HasVoiceStatus, Converter={StaticResource BoolToVisibilityConverter}}"
                           AutomationProperties.AutomationId="VoiceStatusText"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
