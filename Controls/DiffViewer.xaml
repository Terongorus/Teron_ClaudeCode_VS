<UserControl x:Class="TeronClaudeCodeVS.Controls.DiffViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/TeronClaudeCodeVS;component/Core/ChatTheme.xaml"/>
    </UserControl.Resources>
    <Border CornerRadius="{StaticResource RadiusControl}" ClipToBounds="True">
        <ScrollViewer x:Name="Scroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="LinesPanel"/>
        </ScrollViewer>
    </Border>
</UserControl>
