<UserControl x:Class="ClaudeCodeGUI.Controls.MarkdownViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}">
    <FlowDocumentScrollViewer x:Name="Viewer"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              IsToolBarVisible="False"
                              Padding="0"
                              Margin="0"/>
</UserControl>
