<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>

  <Commands package="guidClaudeCodePackage">
    <Groups>
      <!-- Tools menu group -->
      <Group guid="guidClaudeCodeCmdSet" id="ClaudeCodeToolsGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS"/>
      </Group>

      <!-- View menu group -->
      <Group guid="guidClaudeCodeCmdSet" id="ClaudeCodeViewGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_VIEW"/>
      </Group>

      <!-- Solution Explorer item context menu group -->
      <Group guid="guidClaudeCodeCmdSet" id="ClaudeCodeSolutionExplorerGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_ITEMNODE"/>
      </Group>

      <!-- Toolbar group -->
      <Group guid="guidClaudeCodeCmdSet" id="ClaudeCodeToolbarGroup" priority="0x0100">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_TOOL_STANDARD"/>
      </Group>
    </Groups>

    <Buttons>

      <!-- Toolbar button -->
      <Button guid="guidClaudeCodeCmdSet" id="cmdidClaudeCodeToolbar"
              priority="0x0100" type="Button">
        <Parent guid="guidClaudeCodeCmdSet" id="ClaudeCodeToolbarGroup"/>
        <Strings>
          <ButtonText>Claude Code</ButtonText>
        </Strings>
      </Button>

      <!-- Tools menu -->
      <Button guid="guidClaudeCodeCmdSet" id="cmdidClaudeCodeToolsMenu"
              priority="0x0200" type="Button">
        <Parent guid="guidClaudeCodeCmdSet" id="ClaudeCodeToolsGroup"/>
        <Strings>
          <ButtonText>Claude Code</ButtonText>
        </Strings>
      </Button>

      <!-- Solution Explorer context menu -->
      <Button guid="guidClaudeCodeCmdSet" id="cmdidClaudeCodeSolutionExplorer"
              priority="0x0300" type="Button">
        <Parent guid="guidClaudeCodeCmdSet" id="ClaudeCodeSolutionExplorerGroup"/>
        <Strings>
          <ButtonText>Claude Code</ButtonText>
        </Strings>
      </Button>

      <!-- View → Claude Code (tool window command) -->
      <Button guid="guidClaudeCodeCmdSet" id="cmdidClaudeCodeWindow"
              priority="0x0001" type="Button">
        <Parent guid="guidClaudeCodeCmdSet" id="ClaudeCodeViewGroup"/>
        <Strings>
          <ButtonText>Claude Code</ButtonText>
        </Strings>
      </Button>

    </Buttons>
  </Commands>

  <Symbols>

    <!-- Package GUID -->
    <GuidSymbol name="guidClaudeCodePackage" value="{B99322A3-3DA7-4F49-8780-FB0AAAE9F4B9}" />

    <!-- Command set -->
    <GuidSymbol name="guidClaudeCodeCmdSet" value="{09826C76-D07D-4F05-B59C-2DACB68816BF}">
      <!-- Groups -->
      <IDSymbol name="ClaudeCodeToolsGroup" value="0x1010"/>
      <IDSymbol name="ClaudeCodeViewGroup" value="0x1020"/>
      <IDSymbol name="ClaudeCodeSolutionExplorerGroup" value="0x1030"/>
      <IDSymbol name="ClaudeCodeToolbarGroup" value="0x1040"/>

      <!-- Buttons -->
      <IDSymbol name="cmdidClaudeCodeToolbar" value="0x0100"/>
      <IDSymbol name="cmdidClaudeCodeToolsMenu" value="0x0101"/>
      <IDSymbol name="cmdidClaudeCodeSolutionExplorer" value="0x0102"/>
      <IDSymbol name="cmdidClaudeCodeWindow" value="0x0200"/>
    </GuidSymbol>

  </Symbols>

</CommandTable>
