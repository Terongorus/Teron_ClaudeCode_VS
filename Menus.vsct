<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>

  <Commands package="guidAntigravityPackage">
    <Groups>
      <!-- Tools menu group -->
      <Group guid="guidAntigravityCmdSet" id="AntigravityToolsGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS"/>
      </Group>

      <!-- View menu group -->
      <Group guid="guidAntigravityCmdSet" id="AntigravityViewGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_VIEW"/>
      </Group>

      <!-- Solution Explorer item context menu group -->
      <Group guid="guidAntigravityCmdSet" id="AntigravitySolutionExplorerGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_ITEMNODE"/>
      </Group>

      <!-- Toolbar group -->
      <Group guid="guidAntigravityCmdSet" id="AntigravityToolbarGroup" priority="0x0100">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_TOOL_STANDARD"/>
      </Group>
    </Groups>

    <Buttons>

      <!-- Toolbar button -->
      <Button guid="guidAntigravityCmdSet" id="cmdidAntigravityToolbar"
              priority="0x0100" type="Button">
        <Parent guid="guidAntigravityCmdSet" id="AntigravityToolbarGroup"/>
        <Strings>
          <ButtonText>Antigravity</ButtonText>
        </Strings>
      </Button>

      <!-- Tools menu -->
      <Button guid="guidAntigravityCmdSet" id="cmdidAntigravityToolsMenu"
              priority="0x0200" type="Button">
        <Parent guid="guidAntigravityCmdSet" id="AntigravityToolsGroup"/>
        <Strings>
          <ButtonText>Antigravity</ButtonText>
        </Strings>
      </Button>

      <!-- Solution Explorer context menu -->
      <Button guid="guidAntigravityCmdSet" id="cmdidAntigravitySolutionExplorer"
              priority="0x0300" type="Button">
        <Parent guid="guidAntigravityCmdSet" id="AntigravitySolutionExplorerGroup"/>
        <Strings>
          <ButtonText>Antigravity</ButtonText>
        </Strings>
      </Button>

      <!-- View → Antigravity (tool window command) -->
      <Button guid="guidAntigravityCmdSet" id="cmdidAntigravityWindow"
              priority="0x0001" type="Button">
        <Parent guid="guidAntigravityCmdSet" id="AntigravityViewGroup"/>
        <Strings>
          <ButtonText>Antigravity</ButtonText>
        </Strings>
      </Button>

    </Buttons>
  </Commands>

  <Symbols>

    <!-- Your package GUID -->
    <GuidSymbol name="guidAntigravityPackage" value="{8A2B3C4D-E5F6-47A8-9B0C-123456789DEF}" />

    <!-- Your command set -->
    <GuidSymbol name="guidAntigravityCmdSet" value="{A1B2C3D4-E5F6-47A8-9B0C-123456789ABC}">
      <!-- Groups -->
      <IDSymbol name="AntigravityToolsGroup" value="0x1010"/>
      <IDSymbol name="AntigravityViewGroup" value="0x1020"/>
      <IDSymbol name="AntigravitySolutionExplorerGroup" value="0x1030"/>
      <IDSymbol name="AntigravityToolbarGroup" value="0x1040"/>

      <!-- Buttons -->
      <IDSymbol name="cmdidAntigravityToolbar" value="0x0100"/>
      <IDSymbol name="cmdidAntigravityToolsMenu" value="0x0101"/>
      <IDSymbol name="cmdidAntigravitySolutionExplorer" value="0x0102"/>
      <IDSymbol name="cmdidAntigravityWindow" value="0x0200"/>
    </GuidSymbol>

  </Symbols>

</CommandTable>
